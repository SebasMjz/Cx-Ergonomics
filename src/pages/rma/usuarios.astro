---
import AdminLayout from '../../components/AdminLayout.astro';
import { connectMongoose } from '../../lib/mongo';
import { readCookieValue, verifyAuthToken } from '../../lib/auth/jwt';
import { UserModel } from '../../lib/models/User';

const authToken = readCookieValue(Astro.request.headers.get('cookie'), 'cx_auth');
const session = authToken ? verifyAuthToken(authToken) : null;
if (!session) return Astro.redirect('/login');
if (session.role !== 'admin') return Astro.redirect('/rma');

await connectMongoose();
const users = await UserModel.find().sort({ createdAt: -1 }).lean();
---

<AdminLayout
	title="Gestión de Usuarios | CX Ergonomic"
	active="usuarios"
	heading="Gestión de Usuarios"
	subheading="Administra las cuentas del personal técnico y administradores."
	session={session}
>
	<button slot="actions" class="btn btn-dark rounded-pill px-3 fw-semibold" type="button" data-bs-toggle="modal" data-bs-target="#createUserModal">
		<i class="ri-user-add-line me-1"></i> Registrar Usuario
	</button>

	<div class="card shadow-sm">
		<div class="card-header bg-transparent py-3 fw-bold">Usuarios Registrados ({users.length})</div>
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th class="px-4 py-3">Nombre</th>
							<th class="py-3">Correo Electrónico</th>
							<th class="py-3">Rol</th>
							<th class="py-3">Estado</th>
							<th class="px-4 py-3 text-end">Acciones</th>
						</tr>
					</thead>
					<tbody>
						{users.map((user) => (
							<tr>
								<td class="px-4 py-3 fw-bold text-dark">{user.name}</td>
								<td class="py-3 text-muted">{user.email}</td>
								<td class="py-3">
									<span class={`badge px-2 py-1 rounded-pill ${user.role === 'admin' ? 'bg-dark text-white' : 'bg-secondary-subtle text-secondary'}`}>
										{user.role === 'admin' ? 'Administrador' : 'Técnico'}
									</span>
								</td>
								<td class="py-3">
									<span class={`badge px-2 py-1 rounded-pill ${user.is_active ? 'bg-success-subtle text-success' : 'bg-danger-subtle text-danger'}`}>
										{user.is_active ? 'Activo' : 'Inactivo'}
									</span>
								</td>
								<td class="px-4 py-3 text-end">
									{user._id.toString() !== session.sub ? (
										<button type="button" class="btn btn-sm btn-outline-danger px-3 rounded-pill delete-user-btn" data-user-id={user._id.toString()} data-user-name={user.name}>
											<i class="ri-delete-bin-line"></i> Eliminar
										</button>
									) : (
										<span class="text-muted small fst-italic">Tu cuenta</span>
									)}
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- Modal crear usuario -->
	<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered">
			<div class="modal-content border-0 shadow">
				<form id="create-user-form">
					<div class="modal-header">
						<h5 class="modal-title fw-bold">Nuevo Usuario</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
					</div>
					<div class="modal-body p-4">
						<div class="mb-3">
							<label for="new-name" class="form-label small fw-bold text-muted">Nombre Completo</label>
							<input type="text" class="form-control" id="new-name" required placeholder="Ej. Juan Pérez" />
						</div>
						<div class="mb-3">
							<label for="new-email" class="form-label small fw-bold text-muted">Email (Usuario)</label>
							<input type="email" class="form-control" id="new-email" required placeholder="ejemplo@cx.com" />
						</div>
						<div class="mb-3">
							<label for="new-role" class="form-label small fw-bold text-muted">Rol en el Sistema</label>
							<select class="form-select" id="new-role" required>
								<option value="technical">Técnico (Soporte)</option>
								<option value="admin">Administrador (Gestión Completa)</option>
							</select>
						</div>
						<div class="mb-0">
							<label for="new-password" class="form-label small fw-bold text-muted">Contraseña</label>
							<input type="password" class="form-control" id="new-password" required placeholder="Mín. 6 caracteres" minlength="6" />
						</div>
						<div class="alert alert-danger d-none mt-3 py-2 small" id="modal-error-alert"></div>
					</div>
					<div class="modal-footer">
						<button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
						<button type="submit" class="btn btn-dark rounded-pill px-4" id="save-user-btn">Crear Usuario</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Modal confirmar -->
	<div class="modal fade" id="confirmActionModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
			<div class="modal-content border-0 shadow">
				<div class="modal-header">
					<h5 class="modal-title fw-bold" id="confirmActionModalLabel">Confirmar Acción</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body py-3" id="confirm-modal-body" style="font-size: 0.9rem;">¿Estás seguro?</div>
				<div class="modal-footer">
					<button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
					<button type="button" class="btn btn-dark rounded-pill px-3" id="confirm-action-submit-btn">Confirmar</button>
				</div>
			</div>
		</div>
	</div>

	<script is:inline>
		(function () {
			const bs = () => window.bootstrap;
			const form = document.getElementById('create-user-form');
			const errorAlert = document.getElementById('modal-error-alert');
			const saveBtn = document.getElementById('save-user-btn');

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				errorAlert.classList.add('d-none');
				try {
					saveBtn.disabled = true;
					saveBtn.textContent = 'Guardando...';
					const payload = {
						name: document.getElementById('new-name').value,
						email: document.getElementById('new-email').value,
						role: document.getElementById('new-role').value,
						password: document.getElementById('new-password').value,
					};
					const res = await fetch('/api/users/create', {
						method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload),
					});
					const data = await res.json();
					if (!res.ok) throw new Error(data.error || 'Error al crear usuario');
					window.location.reload();
				} catch (err) {
					saveBtn.disabled = false;
					saveBtn.textContent = 'Crear Usuario';
					errorAlert.textContent = err.message;
					errorAlert.classList.remove('d-none');
				}
			});

			let pendingCallback = null;
			function showConfirm(title, message, callback) {
				document.getElementById('confirmActionModalLabel').textContent = title;
				document.getElementById('confirm-modal-body').textContent = message;
				pendingCallback = callback;
				bs().Modal.getOrCreateInstance(document.getElementById('confirmActionModal')).show();
			}
			document.getElementById('confirm-action-submit-btn').addEventListener('click', () => {
				if (pendingCallback) { pendingCallback(); pendingCallback = null; }
				bs().Modal.getInstance(document.getElementById('confirmActionModal')).hide();
			});

			document.querySelectorAll('.delete-user-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const userId = btn.getAttribute('data-user-id');
					const name = btn.getAttribute('data-user-name');
					showConfirm('Eliminar Usuario', `¿Eliminar permanentemente al usuario ${name}?`, async () => {
						try {
							const res = await fetch('/api/users/delete', {
								method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ userId }),
							});
							const data = await res.json();
							if (!res.ok) throw new Error(data.error || 'Error al eliminar usuario');
							window.location.reload();
						} catch (err) { alert('Error: ' + err.message); }
					});
				});
			});
		})();
	</script>
</AdminLayout>
