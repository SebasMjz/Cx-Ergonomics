---
import AdminSidebar from './AdminSidebar.astro';

interface Props {
	title: string;
	active?: string;
	heading: string;
	subheading?: string;
	session: { name: string; role: 'admin' | 'technical'; must_change_password?: boolean };
	headExtra?: string;
}

const { title, active = '', heading, subheading = '', session } = Astro.props;
---

<html lang="es" data-bs-theme="light" data-theme-fixed="light">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1.0, viewport-fit=cover" />
		<title>{title}</title>
		<link href="/css/style.css" rel="stylesheet" />
		<link href="/css/skin.css" rel="stylesheet" />
		<link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&family=Outfit:wght@600;700;800;900&display=swap" rel="stylesheet" />
		<slot name="head" />
		<style>
			:root, [data-bs-theme='light'] {
				--bs-primary: #212529 !important;
				--bs-primary-rgb: 33, 37, 41 !important;
				--bs-link-color: #495057 !important;
				--bs-link-hover-color: #212529 !important;
			}
			body { background-color: #f3f4f6 !important; color: #212529 !important; }
			.card { background-color: #ffffff !important; border-color: rgba(0, 0, 0, 0.08) !important; }

			.border-dashed { border-style: dashed !important; }

			/* ---- Sidebar: columna flexible con footer fijo y contenido desplazable ---- */
			.sidebar { display: flex !important; flex-direction: column; height: 100vh; }
			.sidebar-content { flex: 1 1 auto !important; overflow-y: auto; min-height: 0; }
			.sidebar-footer { flex: 0 0 auto !important; }
			.sidebar-footer #logout-button { white-space: nowrap; }
		</style>
	</head>
	<body>
		<div class="wrapper">
			<AdminSidebar active={active} session={session} />

			<main class="main-content px-2">
				<header class="navbar navbar-expand-lg border-bottom px-3 py-2 bg-dark navbar-dark shadow-sm">
					<div class="container-fluid">
						<button class="btn btn-icon border-0 me-2 text-white" id="sidebar-toggle" type="button" aria-label="Toggle navigation">
							<i class="ri-menu-2-line fs-4"></i>
						</button>
						<span class="navbar-text small text-white-50 d-none d-sm-inline-block">
							<i class="ri-settings-4-line me-1"></i> {heading}
						</span>
					</div>
				</header>

				<div class="content-wrapper py-5">
					<div class="container-fluid">
						<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
							<div>
								<h1 class="h3 mb-0 fw-bold text-dark">{heading}</h1>
								{subheading && <p class="text-muted small mb-0">{subheading}</p>}
							</div>
							<slot name="actions" />
						</div>

						<slot />
					</div>
				</div>
			</main>
		</div>

		{session.must_change_password && (
			<div class="modal fade show" id="mustChangePasswordModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" style="display: block; background: rgba(0,0,0,0.65);" aria-modal="true" role="dialog">
				<div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
					<div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
						<form id="must-change-pass-form">
							<div class="modal-header bg-dark text-white py-3">
								<h5 class="modal-title fw-bold fs-6"><i class="ri-shield-keyhole-line me-2 text-warning"></i>Cambio Obligatorio de Contraseña</h5>
							</div>
							<div class="modal-body p-4">
								<p class="small text-muted mb-3">Es tu primer inicio de sesión. Por motivos de seguridad, debes establecer una contraseña propia para continuar.</p>
								<div class="mb-3">
									<label for="must-new-password" class="form-label small fw-bold text-muted">Nueva Contraseña</label>
									<input type="password" class="form-control" id="must-new-password" required minlength="6" placeholder="Mínimo 6 caracteres" />
								</div>
								<div class="mb-3">
									<label for="must-confirm-password" class="form-label small fw-bold text-muted">Confirmar Nueva Contraseña</label>
									<input type="password" class="form-control" id="must-confirm-password" required minlength="6" placeholder="Repite la contraseña" />
								</div>
								<div id="must-pass-error" class="alert alert-danger d-none py-2 small mb-0"></div>
							</div>
							<div class="modal-footer bg-light p-3">
								<button type="submit" class="btn btn-dark w-100 py-2.5 rounded-pill fw-bold" id="must-pass-submit-btn">
									<i class="ri-check-line me-1"></i> Actualizar Contraseña y Continuar
								</button>
							</div>
						</form>
					</div>
				</div>
			</div>
			<script is:inline>
				document.getElementById('must-change-pass-form')?.addEventListener('submit', async (e) => {
					e.preventDefault();
					const errEl = document.getElementById('must-pass-error');
					const pass = document.getElementById('must-new-password').value;
					const confirm = document.getElementById('must-confirm-password').value;
					const btn = document.getElementById('must-pass-submit-btn');

					if (errEl) errEl.classList.add('d-none');
					if (pass !== confirm) {
						if (errEl) { errEl.textContent = 'Las contraseñas no coinciden.'; errEl.classList.remove('d-none'); }
						return;
					}

					try {
						btn.disabled = true;
						btn.textContent = 'Guardando...';
						const res = await fetch('/api/users/change-password', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({ newPassword: pass }),
						});
						const data = await res.json();
						if (!res.ok) throw new Error(data.error || 'Error al actualizar contraseña');
						window.location.reload();
					} catch (err) {
						btn.disabled = false;
						btn.textContent = 'Actualizar Contraseña y Continuar';
						if (errEl) { errEl.textContent = err.message; errEl.classList.remove('d-none'); }
					}
				});
			</script>
		)}

		<slot name="scripts" />
		<script src="/js/main.js" type="module" is:inline></script>
	</body>
</html>
