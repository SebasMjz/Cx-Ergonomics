---
import SiteNav from './SiteNav.astro';

interface Props {
	title: string;
	description?: string;
	active?: string;
}

const { title, description = 'CX Ergonomic — mobiliario ergonómico y componentes de alto rendimiento.', active = '' } = Astro.props;
---

<html lang="es" data-bs-theme="dark">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />

		<link href="/css/style.css" rel="stylesheet" />
		<link href="/css/skin.css" rel="stylesheet" />
		<link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet" />
		<link href="https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@300;400;600;700&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js" defer></script>

		<style is:global>
			:root {
				--bg: #0a0a0b;
				--bg-elev: #141416;
				--bg-elev-2: #1b1b1e;
				--line: rgba(255, 255, 255, 0.09);
				--line-strong: rgba(255, 255, 255, 0.22);
				--text: #f4f4f6;
				--text-muted: #9a9aa1;
				--accent: #ffffff;
				--font-display: 'Outfit', sans-serif;
				--font-body: 'Source Sans 3', sans-serif;
			}
			html, body { margin: 0; padding: 0; }
			body {
				background-color: var(--bg) !important;
				color: var(--text) !important;
				font-family: var(--font-body);
				overflow-x: hidden;
			}
			.font-display { font-family: var(--font-display); }
			::selection { background: #fff; color: #000; }

			.utility-bar { background: #050506; border-bottom: 1px solid var(--line); font-size: 0.72rem; letter-spacing: 0.08em; }
			.utility-bar a { color: var(--text-muted); text-decoration: none; text-transform: uppercase; font-weight: 600; transition: color 0.2s ease; }
			.utility-bar a:hover { color: #fff; }

			.main-nav { background: rgba(10, 10, 11, 0.92); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
			.brand { font-family: var(--font-display); font-weight: 900; letter-spacing: 0.02em; font-size: 1.15rem; color: #fff; text-decoration: none; display: inline-flex; align-items: center; gap: 0.55rem; text-transform: uppercase; }
			.nav-link-cx { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text); text-decoration: none; padding: 0.4rem 0; position: relative; transition: color 0.2s ease; }
			.nav-link-cx::after { content: ''; position: absolute; left: 0; bottom: -4px; width: 0; height: 2px; background: #fff; transition: width 0.25s ease; }
			.nav-link-cx:hover, .nav-link-cx.active { color: #fff; }
			.nav-link-cx:hover::after, .nav-link-cx.active::after { width: 100%; }
			.icon-btn { background: transparent; border: none; color: var(--text); font-size: 1.2rem; line-height: 1; transition: color 0.2s ease; }
			.icon-btn:hover { color: #fff; }

			.btn-cx-primary { background: #fff; color: #000 !important; border: 1px solid #fff; font-family: var(--font-display); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; font-size: 0.82rem; padding: 0.7rem 1.9rem; border-radius: 2px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.5rem; transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease; cursor: pointer; }
			.btn-cx-primary:hover { background: transparent; color: #fff !important; transform: translateY(-1px); }
			.btn-cx-ghost { background: transparent; color: #fff !important; border: 1px solid var(--line-strong); font-family: var(--font-display); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; font-size: 0.78rem; padding: 0.55rem 1.3rem; border-radius: 2px; text-decoration: none; display: inline-flex; align-items: center; gap: 0.45rem; transition: border-color 0.2s ease, background 0.2s ease; cursor: pointer; }
			.btn-cx-ghost:hover { border-color: #fff; background: rgba(255,255,255,0.06); }

			.section { padding: 4.5rem 0; }
			.section-heading { font-family: var(--font-display); font-weight: 800; font-size: clamp(1.7rem, 3.5vw, 2.6rem); letter-spacing: 0.02em; text-transform: uppercase; color: #fff; text-align: center; margin-bottom: 0.5rem; }
			.section-sub { text-align: center; color: var(--text-muted); max-width: 60ch; margin: 0 auto 3rem; }

			.tag-badge { font-family: var(--font-display); font-weight: 700; font-size: 0.66rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 0.2rem 0.55rem; border-radius: 3px; display: inline-block; line-height: 1.3; }

			.footer { background: #050506; border-top: 1px solid var(--line); padding: 4rem 0 2rem; }
			.footer h6 { font-family: var(--font-display); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; font-size: 0.82rem; color: #fff; margin-bottom: 1.1rem; }
			.footer a { color: var(--text-muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s ease; }
			.footer a:hover { color: #fff; }
			.footer-bottom { border-top: 1px solid var(--line); margin-top: 3rem; padding-top: 1.5rem; color: var(--text-muted); font-size: 0.8rem; }
		</style>
		<slot name="head" />
	</head>
	<body>
		<SiteNav active={active} />

		<main>
			<slot />
		</main>

		<footer class="footer">
			<div class="container">
				<div class="row g-4">
					<div class="col-12 col-lg-4">
						<div class="brand mb-3">
							<img src="/img/logo-cx-ergonomic.webp" alt="CX Ergonomic" style="max-height: 26px;" onerror="this.style.display='none'" />
						</div>
						<p style="color: var(--text-muted); max-width: 38ch; font-size: 0.92rem;">
							Mobiliario ergonómico y componentes de alto rendimiento para tu espacio de trabajo.
						</p>
					</div>
					<div class="col-6 col-md-3 col-lg-2 offset-lg-1">
						<h6>Tienda</h6>
						<ul class="list-unstyled d-flex flex-column gap-2 mb-0">
							<li><a href="/">Catálogo</a></li>
							<li><a href="/distribuidor">Ser distribuidor</a></li>
							<li><a href="/puntos-de-venta">Puntos de venta</a></li>
						</ul>
					</div>
					<div class="col-6 col-md-3 col-lg-2">
						<h6>Recursos</h6>
						<ul class="list-unstyled d-flex flex-column gap-2 mb-0">
							<li><a href="/faq">Preguntas frecuentes</a></li>
							<li><a href="/wallpapers">Wallpapers</a></li>
							<li><a href="/comunidad">Comunidad</a></li>
						</ul>
					</div>
					<div class="col-6 col-md-3 col-lg-2">
						<h6>Soporte</h6>
						<ul class="list-unstyled d-flex flex-column gap-2 mb-0">
							<li><a href="/rma/new">Registrar RMA</a></li>
							<li><a href="/login">Acceso personal</a></li>
						</ul>
					</div>
				</div>
				<div class="footer-bottom d-flex flex-wrap justify-content-between gap-2">
					<span>&copy; 2026 CX Ergonomic Importations S.R.L. Todos los derechos reservados.</span>
					<span>Cochabamba, Bolivia</span>
				</div>
			</div>
		</footer>

		<slot name="scripts" />
	</body>
</html>
