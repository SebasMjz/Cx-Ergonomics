---
import AdminLayout from '../../components/AdminLayout.astro';
import { connectMongoose } from '../../lib/mongo';
import { readCookieValue, verifyAuthToken } from '../../lib/auth/jwt';
import { FaqModel } from '../../lib/models/Faq';

const authToken = readCookieValue(Astro.request.headers.get('cookie'), 'cx_auth');
const session = authToken ? verifyAuthToken(authToken) : null;
if (!session) return Astro.redirect('/login');
if (session.role !== 'admin') return Astro.redirect('/rma');

await connectMongoose();
const faqs = await FaqModel.find().sort({ order: 1 }).lean();
---

<AdminLayout
	title="Preguntas Frecuentes | CX Ergonomic"
	active="faq"
	heading="Preguntas Frecuentes"
	subheading="Gestiona las preguntas mostradas en /faq."
	session={session}
>
	<button slot="actions" class="btn btn-dark rounded-pill px-3 fw-semibold" id="new-faq-btn">
		<i class="ri-add-line me-1"></i> Nueva pregunta
	</button>

	<div class="card shadow-sm">
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th class="px-4 py-3" style="width: 35%;">Pregunta</th>
							<th class="py-3">Respuesta</th>
							<th class="py-3">Estado</th>
							<th class="px-4 py-3 text-end">Acciones</th>
						</tr>
					</thead>
					<tbody>
						{faqs.length === 0 ? (
							<tr><td colspan="4" class="text-center text-muted py-5">No hay preguntas todavía.</td></tr>
						) : faqs.map((faq) => (
							<tr data-id={faq._id.toString()} data-question={faq.question} data-answer={faq.answer} data-active={String(faq.is_active)}>
								<td class="px-4 py-3 fw-semibold">{faq.question}</td>
								<td class="py-3 text-muted small text-truncate" style="max-width: 380px;">{faq.answer}</td>
								<td class="py-3">
									{faq.is_active
										? <span class="badge bg-success-subtle text-success">Visible</span>
										: <span class="badge bg-secondary-subtle text-secondary">Oculta</span>}
								</td>
								<td class="px-4 py-3 text-end">
									<button class="btn btn-sm btn-outline-secondary rounded-pill px-3 edit-faq-btn">Editar</button>
									<button class="btn btn-sm btn-outline-danger rounded-pill px-3 delete-faq-btn">Eliminar</button>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<div class="modal fade" id="faqModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered modal-lg">
			<div class="modal-content border-0 shadow" style="border-radius: 12px;">
				<div class="modal-header bg-light">
					<h5 class="modal-title fw-bold" id="faqModalTitle">Nueva pregunta</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body p-4">
					<input type="hidden" id="faq-id" />
					<div class="mb-3">
						<label class="form-label small fw-bold text-muted">Pregunta</label>
						<input type="text" class="form-control" id="faq-question" />
					</div>
					<div class="mb-3">
						<label class="form-label small fw-bold text-muted">Respuesta</label>
						<textarea class="form-control" id="faq-answer" rows="4"></textarea>
					</div>
					<div class="form-check">
						<input type="checkbox" class="form-check-input" id="faq-active" checked />
						<label class="form-check-label small" for="faq-active">Visible en la tienda</label>
					</div>
					<div class="alert alert-danger d-none mt-3 py-2 small" id="faq-error"></div>
				</div>
				<div class="modal-footer border-top-0">
					<button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
					<button type="button" class="btn btn-dark rounded-pill px-3" id="save-faq-btn">Guardar</button>
				</div>
			</div>
		</div>
	</div>

	<script is:inline>
		(function () {
			const bs = () => window.bootstrap;
			const modalEl = document.getElementById('faqModal');
			const elId = document.getElementById('faq-id');
			const elQ = document.getElementById('faq-question');
			const elA = document.getElementById('faq-answer');
			const elActive = document.getElementById('faq-active');
			const elError = document.getElementById('faq-error');
			const elTitle = document.getElementById('faqModalTitle');

			function openModal(data) {
				elError.classList.add('d-none');
				elId.value = data ? data.id : '';
				elQ.value = data ? data.question : '';
				elA.value = data ? data.answer : '';
				elActive.checked = data ? data.active : true;
				elTitle.textContent = data ? 'Editar pregunta' : 'Nueva pregunta';
				bs().Modal.getOrCreateInstance(modalEl).show();
			}

			document.getElementById('new-faq-btn').addEventListener('click', () => openModal());

			document.querySelectorAll('.edit-faq-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const row = btn.closest('tr');
					openModal({
						id: row.getAttribute('data-id'),
						question: row.getAttribute('data-question'),
						answer: row.getAttribute('data-answer'),
						active: row.getAttribute('data-active') === 'true',
					});
				});
			});

			document.getElementById('save-faq-btn').addEventListener('click', async () => {
				elError.classList.add('d-none');
				const id = elId.value;
				const payload = { id, question: elQ.value.trim(), answer: elA.value.trim(), is_active: elActive.checked };
				if (!payload.question || !payload.answer) { elError.textContent = 'Pregunta y respuesta son obligatorias.'; elError.classList.remove('d-none'); return; }
				try {
					const res = await fetch(id ? '/api/catalog/faq/update' : '/api/catalog/faq/create', {
						method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload),
					});
					const data = await res.json();
					if (!res.ok) throw new Error(data.error || 'Error al guardar');
					window.location.reload();
				} catch (err) { elError.textContent = err.message; elError.classList.remove('d-none'); }
			});

			document.querySelectorAll('.delete-faq-btn').forEach((btn) => {
				btn.addEventListener('click', async () => {
					const row = btn.closest('tr');
					if (!confirm('¿Eliminar esta pregunta?')) return;
					const res = await fetch('/api/catalog/faq/delete', {
						method: 'POST', headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ id: row.getAttribute('data-id') }),
					});
					if (res.ok) window.location.reload(); else alert('No se pudo eliminar.');
				});
			});
		})();
	</script>
</AdminLayout>
