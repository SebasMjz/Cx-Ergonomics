		<!-- Drag and Drop & Modal implementation scripts -->
		<script>
			document.addEventListener('DOMContentLoaded', () => {
				function showToast(message: string, type: 'success' | 'danger' | 'warning' | 'info' = 'danger') {
					const toastEl = document.getElementById('app-toast');
					const iconEl = document.getElementById('app-toast-icon');
					const msgEl = document.getElementById('app-toast-message');
					if (!toastEl || !iconEl || !msgEl) return;

					// Reset classes
					toastEl.className = 'toast align-items-center text-white border-0 shadow-lg';
					iconEl.className = 'fs-5';

					// Apply type style
					if (type === 'success') {
						toastEl.classList.add('bg-success');
						iconEl.className = 'ri-checkbox-circle-fill fs-5';
					} else if (type === 'warning') {
						toastEl.classList.add('bg-warning', 'text-dark');
						toastEl.classList.remove('text-white');
						iconEl.className = 'ri-error-warning-fill fs-5';
					} else if (type === 'info') {
						toastEl.classList.add('bg-info');
						iconEl.className = 'ri-information-fill fs-5';
					} else {
						toastEl.classList.add('bg-danger');
						iconEl.className = 'ri-close-circle-fill fs-5';
					}

					msgEl.textContent = message;

					// @ts-ignore
					const bsToast = bootstrap.Toast.getOrCreateInstance(toastEl);
					bsToast.show();
				}

				// Close handler for media preview overlay
				const previewOverlay = document.getElementById('mediaPreviewOverlay');
				const previewCloseBtn = document.getElementById('mediaPreviewClose');
				const previewVideo = document.getElementById('mediaPreviewVideo') as HTMLVideoElement | null;

				if (previewOverlay && previewCloseBtn) {
					const closeAction = () => {
						previewOverlay.classList.add('d-none');
						previewOverlay.classList.remove('d-flex');
						if (previewVideo) {
							previewVideo.pause();
							previewVideo.src = '';
						}
					};

					previewCloseBtn.addEventListener('click', closeAction);
					previewOverlay.addEventListener('click', (e) => {
						if (e.target === previewOverlay) {
							closeAction();
						}
					});
				}

				const draggables = document.querySelectorAll('.draggable-ticket');
				const columns = document.querySelectorAll('.lane-column');

				// Dynamic Time-Ago calculation on client side
				function updateTimeAgoLabels() {
					const labels = document.querySelectorAll('.time-ago-label');
					const now = new Date();
					labels.forEach(label => {
						const timestampStr = label.getAttribute('data-timestamp');
						if (!timestampStr) return;
						const date = new Date(timestampStr);
						const diffMs = now.getTime() - date.getTime();
						const minutes = Math.floor(diffMs / 60000);
						
						let text = '';
						if (minutes < 1) {
							text = 'Hace unos instantes';
						} else if (minutes < 60) {
							text = `Hace ${minutes} min`;
						} else {
							const hours = Math.floor(minutes / 60);
							if (hours < 24) {
								text = `Hace ${hours} h`;
							} else {
								const days = Math.floor(hours / 24);
								text = `Hace ${days} d`;
							}
						}
						label.innerHTML = `<i class="ri-time-line me-1"></i>${text}`;
					});
				}
				updateTimeAgoLabels();
				setInterval(updateTimeAgoLabels, 30000);

				// Helper global para subir archivos (imágenes/videos/PDFs)
				function uploadFile(file: File, kind: string = 'receipt'): Promise<string> {
					const fd = new FormData();
					fd.append('file', file);
					return new Promise((resolve, reject) => {
						const xhr = new XMLHttpRequest();
						xhr.open('POST', `/api/tickets/upload?kind=${kind}`);
						xhr.addEventListener('load', () => {
							if (xhr.status === 201) {
								try {
									const r = JSON.parse(xhr.responseText);
									resolve(r.path || r.url);
								} catch {
									reject(new Error('Respuesta inválida del servidor'));
								}
							} else {
								try {
									reject(new Error(JSON.parse(xhr.responseText).error || 'Error al subir'));
								} catch {
									reject(new Error('Error al subir archivo'));
								}
							}
						});
						xhr.addEventListener('error', () => reject(new Error('Error de conexión al subir archivo')));
						xhr.send(fd);
					});
				}

				// Hide alert dots for tickets already opened/read by staff
				function updateClientAlertDots() {
					let readTickets: string[] = [];
					try {
						readTickets = JSON.parse(localStorage.getItem('read_client_tickets') || '[]');
					} catch {}

					document.querySelectorAll('.draggable-ticket').forEach(card => {
						const ticketNum = card.getAttribute('data-ticket-number');
						// @ts-ignore
						const ticket = window.ALL_TICKETS?.find((t: any) => t.ticket_number === ticketNum);
						if (ticket) {
							const lastClientMsg = ticket.history?.filter((h: any) => h.from_client).pop();
							if (lastClientMsg) {
								const clientKey = `${ticket.ticket_number}_${new Date(lastClientMsg.updated_at).getTime()}`;
								if (readTickets.includes(clientKey)) {
									const dot = card.querySelector('.bg-danger');
									if (dot) dot.remove();
								}
							}
						}
					});
				}
				updateClientAlertDots();

				// Custom action confirmation modal helper
				let pendingActionCallback: (() => void) | null = null;
				function showConfirmModal(title: string, message: string, callback: () => void) {
					const titleEl = document.getElementById('confirmActionModalLabel');
					const bodyEl = document.getElementById('confirm-modal-body');
					if (titleEl) titleEl.textContent = title;
					if (bodyEl) bodyEl.textContent = message;
					
					pendingActionCallback = callback;
					
					// @ts-ignore
					const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmActionModal'));
					modal.show();
				}

				document.getElementById('confirm-action-submit-btn')?.addEventListener('click', () => {
					if (pendingActionCallback) {
						pendingActionCallback();
						pendingActionCallback = null;
					}
					// @ts-ignore
					const modal = bootstrap.Modal.getInstance(document.getElementById('confirmActionModal'));
					modal?.hide();
				});

				// ---- Dedicated Modal: Recepción en Sucursal (Paso 1 para En proceso) ----
				let pendingBranchReceive: { ticketNumber: string; orderedNumbers: any[] } | null = null;
				let branchReceiveSubmitting = false;
				const branchReceiveModalEl = document.getElementById('branchReceiveModal');

				function openBranchReceiveModal(ticketNumber: string, orderedNumbers: any[]) {
					pendingBranchReceive = { ticketNumber, orderedNumbers };
					branchReceiveSubmitting = false;

					const numEl = document.getElementById('branch-receive-ticket-number');
					if (numEl) numEl.textContent = ticketNumber;

					const chkEl = document.getElementById('branch-receive-checkbox') as HTMLInputElement;
					if (chkEl) chkEl.checked = false;

					document.getElementById('branch-receive-error')?.classList.add('d-none');
					// @ts-ignore
					bootstrap.Modal.getOrCreateInstance(branchReceiveModalEl).show();
				}

				branchReceiveModalEl?.addEventListener('hidden.bs.modal', () => {
					if (pendingBranchReceive && !branchReceiveSubmitting) {
						window.location.reload();
					}
				});

				document.getElementById('branch-receive-submit-btn')?.addEventListener('click', async () => {
					if (!pendingBranchReceive) return;
					const errEl = document.getElementById('branch-receive-error');
					const chk = (document.getElementById('branch-receive-checkbox') as HTMLInputElement).checked;

					if (!chk) {
						if (errEl) {
							errEl.textContent = 'Debes confirmar que el producto fue dejado físicamente en la sucursal para avanzar a En proceso.';
							errEl.classList.remove('d-none');
						}
						return;
					}

					const btn = document.getElementById('branch-receive-submit-btn') as HTMLButtonElement;
					try {
						branchReceiveSubmitting = true;
						btn.disabled = true;
						btn.textContent = 'Guardando...';

						// 1. Guardar el paso 1 (step_left_at_branch)
						const stepRes = await fetch('/api/tickets/update-steps', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({
								ticketNumber: pendingBranchReceive.ticketNumber,
								step_left_at_branch: true,
							}),
						});
						if (!stepRes.ok) throw new Error('Error al actualizar el paso de sucursal');

						// 2. Mover el estado del ticket a "en proceso"
						const statusRes = await fetch('/api/tickets/update-status', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({
								ticketNumber: pendingBranchReceive.ticketNumber,
								status: 'en proceso',
								orderedNumbers: pendingBranchReceive.orderedNumbers,
							}),
						});
						if (!statusRes.ok) throw new Error('Error al actualizar el estado a En proceso');

						window.location.reload();
					} catch (err: any) {
						branchReceiveSubmitting = false;
						btn.disabled = false;
						btn.innerHTML = '<i class="ri-checkbox-circle-line me-1 text-success"></i> Confirmar y Pasar a En Proceso';
						if (errEl) {
							errEl.textContent = err.message;
							errEl.classList.remove('d-none');
						}
					}
				});

				// ---- Modal de Pasos Obligatorios Faltantes ----
				let pendingCompleteSteps: { ticketNumber: string; status: string; orderedNumbers: any[] } | null = null;
				let completeStepsSubmitting = false;
				const completeStepsModalEl = document.getElementById('completeStepsModal');

				function openCompleteStepsModal(ticketNumber: string, status: string, orderedNumbers: any[]) {
					pendingCompleteSteps = { ticketNumber, status, orderedNumbers };
					completeStepsSubmitting = false;

					const numEl = document.getElementById('complete-steps-ticket-number');
					if (numEl) numEl.textContent = ticketNumber;

					// @ts-ignore
					const ticket = window.ALL_TICKETS.find(t => t.ticket_number === ticketNumber);
					
					const step1El = document.getElementById('cstep-left-at-branch') as HTMLInputElement;
					const step2El = document.getElementById('cstep-sent-to-distributor') as HTMLInputElement;
					const step3El = document.getElementById('cstep-resolved') as HTMLInputElement;
					
					if (ticket) {
						step1El.checked = !!ticket.step_left_at_branch;
						step1El.disabled = !!ticket.step_left_at_branch;
						
						step2El.checked = !!ticket.step_sent_to_distributor;
						step2El.disabled = !!ticket.step_sent_to_distributor;
						
						step3El.checked = !!ticket.step_resolved;
						step3El.disabled = !!ticket.step_resolved;
					} else {
						step1El.checked = false;
						step1El.disabled = false;
						step2El.checked = false;
						step2El.disabled = false;
						step3El.checked = false;
						step3El.disabled = false;
					}

					document.getElementById('complete-steps-error')?.classList.add('d-none');
					// @ts-ignore
					bootstrap.Modal.getOrCreateInstance(completeStepsModalEl).show();
				}

				completeStepsModalEl?.addEventListener('hidden.bs.modal', () => {
					if (pendingCompleteSteps && !completeStepsSubmitting) {
						window.location.reload();
					}
				});

				document.getElementById('complete-steps-submit-btn')?.addEventListener('click', async () => {
					if (!pendingCompleteSteps) return;
					const errEl = document.getElementById('complete-steps-error');
					const showErr = (msg: string) => {
						if (errEl) {
							errEl.textContent = msg;
							errEl.classList.remove('d-none');
						}
					};

					const step_left_at_branch = (document.getElementById('cstep-left-at-branch') as HTMLInputElement).checked;
					const step_sent_to_distributor = (document.getElementById('cstep-sent-to-distributor') as HTMLInputElement).checked;
					const step_resolved = (document.getElementById('cstep-resolved') as HTMLInputElement).checked;

					if (pendingCompleteSteps.status === 'en proceso') {
						if (!step_left_at_branch) {
							return showErr('Debes marcar que el producto fue dejado en la sucursal para pasar a En proceso.');
						}
					} else if (!step_left_at_branch || !step_sent_to_distributor || !step_resolved) {
						return showErr('Debes marcar todos los pasos obligatorios antes de finalizar.');
					}

					const btn = document.getElementById('complete-steps-submit-btn') as HTMLButtonElement;
					try {
						completeStepsSubmitting = true;
						btn.disabled = true;
						btn.textContent = 'Guardando...';

						const res = await fetch('/api/tickets/update-steps', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({
								ticketNumber: pendingCompleteSteps.ticketNumber,
								step_left_at_branch,
								step_sent_to_distributor,
								step_resolved,
							}),
						});
						const data = await res.json();
						if (!res.ok) throw new Error(data.error || 'Error al guardar los pasos');

						// @ts-ignore
						const ticket = window.ALL_TICKETS.find(t => t.ticket_number === pendingCompleteSteps.ticketNumber);
						if (ticket) {
							ticket.step_left_at_branch = true;
							ticket.step_sent_to_distributor = true;
							ticket.step_resolved = true;
						}

						// @ts-ignore
						bootstrap.Modal.getOrCreateInstance(completeStepsModalEl).hide();
						openFinalizeModal(pendingCompleteSteps.ticketNumber, pendingCompleteSteps.status, pendingCompleteSteps.orderedNumbers);
					} catch (err: any) {
						completeStepsSubmitting = false;
						btn.disabled = false;
						btn.innerHTML = 'Guardar y continuar <i class="ri-arrow-right-line ms-1"></i>';
						showErr(err.message || 'Error de red');
					}
				});

				// ---- Modal de finalización (resolución) ----
				let pendingFinalize: { ticketNumber: string; status: string; orderedNumbers: any[] } | null = null;
				let finalizeSubmitting = false;
				const finalizeModalEl = document.getElementById('finalizeModal');

				function openFinalizeModal(ticketNumber: string, status: string, orderedNumbers: any[]) {
					pendingFinalize = { ticketNumber, status, orderedNumbers };
					finalizeSubmitting = false;

					const numEl = document.getElementById('finalize-ticket-number');
					if (numEl) numEl.textContent = ticketNumber;

					document.querySelectorAll('input[name="finalize-type"]').forEach((el) => {
						(el as HTMLInputElement).checked = false;
					});
					(document.getElementById('finalize-main-comment') as HTMLTextAreaElement).value = '';
					(document.getElementById('finalize-client-solution') as HTMLTextAreaElement).value = '';
					(document.getElementById('finalize-supplier-solution') as HTMLTextAreaElement).value = '';
					(document.getElementById('finalize-client-transaction') as HTMLInputElement).value = '';
					(document.getElementById('finalize-supplier-transaction') as HTMLInputElement).value = '';
					document.getElementById('finalize-error')?.classList.add('d-none');

					// @ts-ignore
					bootstrap.Modal.getOrCreateInstance(finalizeModalEl).show();
				}

				// Si se cierra sin finalizar, recargar para revertir el arrastre visual.
				finalizeModalEl?.addEventListener('hidden.bs.modal', () => {
					if (pendingFinalize && !finalizeSubmitting) {
						window.location.reload();
					}
				});

				document.getElementById('finalize-submit-btn')?.addEventListener('click', async () => {
					if (!pendingFinalize) return;
					const errEl = document.getElementById('finalize-error');
					const showErr = (msg: string) => {
						if (errEl) {
							errEl.textContent = msg;
							errEl.classList.remove('d-none');
						}
					};

					const typeEl = document.querySelector('input[name="finalize-type"]:checked') as HTMLInputElement | null;
					const mainComment = (document.getElementById('finalize-main-comment') as HTMLTextAreaElement).value.trim();
					const clientSolution = (document.getElementById('finalize-client-solution') as HTMLTextAreaElement).value.trim();
					const supplierSolution = (document.getElementById('finalize-supplier-solution') as HTMLTextAreaElement).value.trim();
					const clientTransactionNumber = (document.getElementById('finalize-client-transaction') as HTMLInputElement).value.trim();
					const supplierTransactionNumber = (document.getElementById('finalize-supplier-transaction') as HTMLInputElement).value.trim();

					if (!typeEl) return showErr('Selecciona un tipo de resolución (Rechazo, Descuento o Reponer).');
					if (!mainComment) return showErr('Escribe el comentario principal de la resolución.');
					if (typeEl.value !== 'rechazo' && !clientSolution && !supplierSolution) return showErr('Registra al menos una solución (al cliente o del proveedor).');

					const btn = document.getElementById('finalize-submit-btn') as HTMLButtonElement;
					try {
						finalizeSubmitting = true;
						btn.disabled = true;
						btn.textContent = 'Finalizando...';
						const res = await fetch('/api/tickets/update-status', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({
								ticketNumber: pendingFinalize.ticketNumber,
								status: pendingFinalize.status,
								orderedNumbers: pendingFinalize.orderedNumbers,
								resolutionType: typeEl.value,
								mainComment,
								clientSolution,
								supplierSolution,
								clientTransactionNumber,
								supplierTransactionNumber,
							}),
						});
						const data = await res.json();
						if (!res.ok) throw new Error(data.error || 'Error al finalizar el ticket');
						window.location.reload();
					} catch (err: any) {
						finalizeSubmitting = false;
						btn.disabled = false;
						btn.innerHTML = '<i class="ri-check-line me-1"></i>Finalizar ticket';
						showErr(err.message);
					}
				});

				// Drag-and-drop vertical sort helper
				function getDragAfterElement(container: Element, y: number) {
					const draggableElements = [...container.querySelectorAll('.draggable-ticket:not(.dragging)')];
					return draggableElements.reduce((closest, child) => {
						const box = child.getBoundingClientRect();
						const offset = y - box.top - box.height / 2;
						if (offset < 0 && offset > closest.offset) {
							return { offset: offset, element: child };
						} else {
							return closest;
						}
					}, { offset: Number.NEGATIVE_INFINITY } as { offset: number; element: Element | null }).element;
				}

				document.querySelectorAll('.draggable-ticket').forEach(draggable => {
					if (draggable instanceof HTMLElement) {
						draggable.addEventListener('dragstart', (e) => {
							draggable.classList.add('dragging');
							draggable.style.opacity = '0.5';
						});

						draggable.addEventListener('dragend', () => {
							draggable.classList.remove('dragging');
							draggable.style.opacity = '1';
						});
						
						// Prevent modal opening when dragging cards
						draggable.addEventListener('click', (e) => {
							if (draggable.classList.contains('dragging')) return;
							
							// Prevent open modal if click was on a button
							const target = e.target as HTMLElement;
							if (target.closest('.advance-ticket-btn') || target.closest('.reject-ticket-btn') || target.closest('.archive-ticket-btn') || target.closest('.wa-ticket-btn') || target.closest('.print-ticket-btn')) return;
							
							const tNum = draggable.getAttribute('data-ticket-number');
							// @ts-ignore
							const ticket = window.ALL_TICKETS.find(t => t.ticket_number === tNum);
							if (ticket) {
								openTicketDetailsModal(ticket);
							}
						});
					}
				});

				// ---- Función helper para actualizar el estado del ticket ----
				async function updateTicketStatus(ticketNumber: string, status: string, orderedNumbers: any[] = []) {
					try {
						const res = await fetch('/api/tickets/update-status', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({ ticketNumber, status, orderedNumbers }),
						});
						const data = await res.json();
						if (!res.ok) throw new Error(data.error || 'Error al actualizar el estado');
						window.location.reload();
					} catch (err: any) {
						console.error(err);
						showToast(err.message || 'Error al actualizar estado', 'danger');
						window.location.reload();
					}
				}

				// ---- Impresión de Etiqueta/Sticker RMA para pegar al producto ----
				function printRmaSticker(ticket: any) {
					const printWin = window.open('', '_blank', 'width=420,height=500');
					if (!printWin) {
						alert('Por favor permite las ventanas emergentes (popups) para imprimir el ticket.');
						return;
					}

					const dateStr = ticket.createdAtStr || (ticket.createdAt ? new Intl.DateTimeFormat('es-VE', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(ticket.createdAt)) : '');
					const clientName = ticket.customer_details?.name || ticket.customerName || '—';
					const clientPhone = ticket.customer_details?.phone || ticket.customerPhone || '—';
					
					const managerName = ticket.store_manager_name || ticket.storeManagerName || '';
					const managerPhone = ticket.store_manager_phone || ticket.storeManagerPhone || '';
					
					const contactInfo = managerName
						? managerName + ' (' + (managerPhone || clientPhone) + ') [Encargado]'
						: clientName + ' (' + clientPhone + ')';

					const serial = ticket.product_serial_number || ticket.productSerialNumber || '—';
					const product = ticket.product_name || ticket.productName || '—';
					const brand = ticket.product_brand || ticket.productBrand || '—';
					const desc = ticket.issue_description || ticket.issueDescription || '—';

					const html = [
						'<!DOCTYPE html>',
						'<html lang="es"><head><meta charset="utf-8">',
						'<title>Etiqueta RMA - ' + ticket.ticket_number + '</title>',
						'<style>',
						'@page { size: 80mm auto; margin: 3mm; }',
						'body { font-family: Arial, Helvetica, sans-serif; width: 270px; margin: 0 auto; padding: 6px; color: #000; font-size: 12px; line-height: 1.3; }',
						'.header { text-align: center; border-bottom: 2px solid #000; padding-bottom: 4px; margin-bottom: 6px; }',
						'.title { font-size: 13px; font-weight: bold; text-transform: uppercase; letter-spacing: 1px; }',
						'.ticket-num { border: 3px solid #000; text-align: center; font-size: 20px; font-weight: 900; padding: 6px 0; margin: 6px 0; background: #000; color: #fff; letter-spacing: 1px; }',
						'.item { margin-bottom: 5px; font-size: 11px; }',
						'.label { font-weight: bold; text-transform: uppercase; font-size: 10px; color: #333; }',
						'.val { font-weight: bold; color: #000; }',
						'.box { border: 1px solid #000; padding: 5px; font-size: 11px; margin-top: 4px; word-break: break-word; background: #f9f9f9; }',
						'</style></head><body>',
						'<div class="header"><div class="title">GARANTÍA RMA</div></div>',
						'<div class="ticket-num">' + ticket.ticket_number + '</div>',
						'<div class="item"><span class="label">FECHA:</span> <span class="val">' + dateStr + '</span></div>',
						'<div class="item"><span class="label">CONTACTO:</span> <span class="val">' + contactInfo + '</span></div>',
						'<div style="border-bottom: 1px dashed #000; margin: 6px 0;"></div>',
						'<div class="item"><span class="label">PRODUCTO:</span> <span class="val">' + product + '</span></div>',
						'<div class="item"><span class="label">MARCA:</span> <span class="val">' + brand + '</span></div>',
						'<div class="item"><span class="label">SERIAL S/N:</span> <span class="val" style="font-size: 13px;">' + serial + '</span></div>',
						'<div style="border-bottom: 1px dashed #000; margin: 6px 0;"></div>',
						'<div class="item"><span class="label">FALLA REPORTADA:</span></div>',
						'<div class="box">' + desc + '</div>',
						'<script>window.onload = function() { window.print(); setTimeout(function() { window.close(); }, 500); };</' + 'script>',
						'</body></html>'
					].join('\n');

					printWin.document.write(html);
					printWin.document.close();
				}

				// ---- Listener para el botón "Avanzar Estado" ----
				document.querySelectorAll('.advance-ticket-btn').forEach((btn) => {
					btn.addEventListener('click', (e) => {
						e.preventDefault();
						e.stopPropagation();
						const ticketNumber = btn.getAttribute('data-ticket-number');
						const nextStatus = btn.getAttribute('data-next-status');
						if (!ticketNumber || !nextStatus) return;

						const columnTarget = document.querySelector('.lane-column[data-status="' + nextStatus + '"]');
						const targetNumbers = columnTarget
							? Array.from(columnTarget.querySelectorAll('.draggable-ticket'))
									.map((el) => el.getAttribute('data-ticket-number'))
									.filter(Boolean)
							: [];
						if (!targetNumbers.includes(ticketNumber)) {
							targetNumbers.unshift(ticketNumber);
						}

						if (nextStatus === 'en proceso') {
							// @ts-ignore
							const ticket = (window.ALL_TICKETS || []).find((t: any) => t.ticket_number === ticketNumber);
							if (ticket && !ticket.step_left_at_branch) {
								openBranchReceiveModal(ticketNumber, targetNumbers);
								return;
							}
						}

						if (nextStatus === 'finalizada' || nextStatus === 'rechazada') {
							openFinalizeModal(ticketNumber, nextStatus, targetNumbers);
						} else {
							updateTicketStatus(ticketNumber, nextStatus, targetNumbers);
						}
					});
				});

				// ---- Listener para el botón "Imprimir Ticket" de la tarjeta ----
				document.querySelectorAll('.print-ticket-btn').forEach((btn) => {
					btn.addEventListener('click', (e) => {
						e.preventDefault();
						e.stopPropagation();
						const ticketNumber = btn.getAttribute('data-ticket-number');
						// @ts-ignore
						const ticket = (window.ALL_TICKETS || []).find((t: any) => t.ticket_number === ticketNumber);
						if (ticket) {
							printRmaSticker(ticket);
						}
					});
				});

				// ---- Polling a 5 minutos (300,000 ms) ----
				let lastKnownUpdate = 0;
				let lastKnownCount = 0;

				setInterval(async () => {
					try {
						// Si hay algún modal abierto o el usuario está interactuando, omitir recarga
						const hasActiveModal = document.querySelector('.modal.show');
						if (hasActiveModal) return;

						const res = await fetch('/api/tickets/check-updates');
						if (res.ok) {
							const data = await res.json();
							if (lastKnownUpdate > 0 && (data.lastUpdated > lastKnownUpdate || data.count !== lastKnownCount)) {
								window.location.reload();
							} else {
								lastKnownUpdate = data.lastUpdated;
								lastKnownCount = data.count;
							}
						}
					} catch (err) {
						console.error('Error polling updates:', err);
					}
				}, 300000);

				// Kanban Drag-and-Drop Event Handlers
				document.querySelectorAll('.lane-column').forEach(column => {
					column.addEventListener('dragover', (e) => {
						e.preventDefault();
						column.classList.add('bg-secondary-subtle');
						
						const dragging = document.querySelector('.dragging');
						if (!dragging) return;
						
						// Find correct position and insert
						const afterElement = getDragAfterElement(column, (e as DragEvent).clientY);
						if (afterElement == null) {
							column.appendChild(dragging);
						} else {
							column.insertBefore(dragging, afterElement);
						}
					});

					column.addEventListener('dragleave', () => {
						column.classList.remove('bg-secondary-subtle');
					});

					column.addEventListener('drop', async (e) => {
						e.preventDefault();
						column.classList.remove('bg-secondary-subtle');
						
						const dragging = document.querySelector('.dragging');
						if (!dragging) return;
						
						const ticketNumber = dragging.getAttribute('data-ticket-number');
						const newStatus = column.getAttribute('data-status');
						const originalStatus = dragging.getAttribute('data-status-type');

						// Validación: No está permitido mover un ticket a un estado anterior de manera manual
						const statusOrderMap = {
							recibida: 0,
							'en revision': 1,
							'en proceso': 2,
							finalizada: 3,
							rechazada: 3,
						};

						const originalIndex = statusOrderMap[originalStatus] ?? 0;
						const newIndex = statusOrderMap[newStatus] ?? 0;

						if (newStatus !== 'rechazada' && newIndex < originalIndex) {
							showToast('No está permitido mover un ticket a un estado anterior de manera manual.', 'danger');
							window.location.reload();
							return;
						}
						
						// Get new ordered list of tickets in this lane
						const orderedNumbers = [...column.querySelectorAll('.draggable-ticket')]
							.map(card => card.getAttribute('data-ticket-number'))
							.filter(Boolean);
						
						// Remove empty state if present in the target column
						const emptyState = column.querySelector('.empty-state');
						if (emptyState) {
							emptyState.remove();
						}

						// Al pasar a "En proceso" se exige que el 1er paso (Producto dejado en la sucursal) esté marcado.
						if (newStatus === 'en proceso' && ticketNumber) {
							// @ts-ignore
							const ticket = window.ALL_TICKETS.find(t => t.ticket_number === ticketNumber);
							if (ticket && !ticket.step_left_at_branch) {
								openBranchReceiveModal(ticketNumber, orderedNumbers);
								return;
							}
						}

						// Al pasar a "Finalizada" se exige registrar la resolución antes de guardar.
						if (newStatus === 'finalizada' && ticketNumber) {
							// @ts-ignore
							const ticket = window.ALL_TICKETS.find(t => t.ticket_number === ticketNumber);
							if (ticket) {
								const step1 = !!ticket.step_left_at_branch;
								const step2 = !!ticket.step_sent_to_distributor;
								const step3 = !!ticket.step_resolved;
								if (!step1 || !step2 || !step3) {
									openCompleteStepsModal(ticketNumber, newStatus, orderedNumbers);
									return;
								}
							}
							openFinalizeModal(ticketNumber, newStatus, orderedNumbers);
							return;
						}

						// Al pasar a "Rechazada" se exige registrar el motivo del rechazo antes de guardar.
						if (newStatus === 'rechazada' && ticketNumber) {
							openRejectModal(ticketNumber, newStatus, orderedNumbers);
							return;
						}

						// Update in database via API
						try {
							const response = await fetch('/api/tickets/update-status', {
								method: 'POST',
								headers: { 'content-type': 'application/json' },
								body: JSON.stringify({ ticketNumber, status: newStatus, orderedNumbers })
							});
							
							if (!response.ok) {
								throw new Error('Error al actualizar el estado en el servidor');
							}
							
							// Reload page to update metrics and counts correctly
							window.location.reload();
						} catch (error) {
							console.error(error);
							showToast('No se pudo guardar el cambio de estado en el servidor.', 'danger');
							window.location.reload();
						}
					});
				});

				// Modal Previsualización de Medios (Lightbox)
				function openMediaPreviewModal(url: string, title: string = 'Previsualización') {
					const modalEl = document.getElementById('mediaPreviewModal');
					const container = document.getElementById('media-preview-container');
					const titleEl = document.getElementById('media-preview-title');
					const downloadLink = document.getElementById('media-preview-download') as HTMLAnchorElement | null;

					if (!modalEl || !container) return;

					if (titleEl) titleEl.innerHTML = `<i class="ri-eye-line me-2 text-info"></i>${title}`;
					if (downloadLink) downloadLink.href = url;

					const ext = (url.split('.').pop() || '').toLowerCase();
					const isVideo = ['mp4', 'mov', 'webm'].includes(ext);
					const isPdf = ext === 'pdf';

					if (isVideo) {
						container.innerHTML = `<video src="${url}" controls autoplay class="mw-100 mh-100 rounded shadow" style="max-height: 70vh;"></video>`;
					} else if (isPdf) {
						container.innerHTML = `
							<div class="w-100 d-flex flex-column align-items-center justify-content-center p-2 rounded bg-white text-dark" style="min-height: 65vh;">
								<object data="${url}" type="application/pdf" class="w-100 rounded" style="height: 65vh; min-height: 420px;">
									<embed src="${url}" type="application/pdf" class="w-100" style="height: 65vh; min-height: 420px;" />
									<div class="text-center p-4">
										<i class="ri-file-pdf-2-line fs-1 text-danger mb-2 d-block"></i>
										<h5 class="fw-bold text-dark mb-2">Documento PDF Factura</h5>
										<p class="text-muted small mb-3">Si tu navegador no muestra la previsualización directa, puedes abrir el PDF completo a continuación.</p>
										<a href="${url}" target="_blank" rel="noopener" class="btn btn-danger rounded-pill px-4 fw-bold">
											<i class="ri-external-link-line me-1"></i> Abrir Documento PDF
										</a>
									</div>
								</object>
							</div>`;
					} else {
						container.innerHTML = `<img src="${url}" alt="Previsualización" class="img-fluid rounded shadow" style="max-height: 70vh; object-fit: contain;" />`;
					}

					// @ts-ignore
					const modal = window.bootstrap?.Modal?.getOrCreateInstance(modalEl);
					modal?.show();
				}

				// Details Modal renderer
				function openTicketDetailsModal(ticket: any) {
					const modalNumber = document.getElementById('modal-ticket-number');
					if (modalNumber) modalNumber.textContent = ticket.ticket_number;
					
					const modalBody = document.getElementById('modal-body-content');
					if (!modalBody) return;

					// Mark ticket as read by staff so red alert dot disappears
					try {
						let readTickets: string[] = JSON.parse(localStorage.getItem('read_client_tickets') || '[]');
						if (!readTickets.includes(ticket.ticket_number)) {
							readTickets.push(ticket.ticket_number);
							localStorage.setItem('read_client_tickets', JSON.stringify(readTickets));
						}
					} catch {}
					updateClientAlertDots();
					
					// Render de un mensaje como burbuja de chat. El cliente va a la derecha; el equipo a la izquierda.
					const renderMsg = (h: any) => {
						const dateStr = new Intl.DateTimeFormat('es-VE', {
							day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
						}).format(new Date(h.updated_at));
						const fromClient = !!h.from_client;
						const author = fromClient ? (h.author_name || 'Cliente') : (h.userName || h.author_name || 'Equipo');
						const statusLabel = h.status === 'recibida' ? 'Nuevas solicitudes' : h.status === 'en proceso' ? 'En proceso' : 'Finalizadas';

						const atts = Array.isArray(h.attachments) ? h.attachments : [];
						const attHtml = atts.length === 0 ? '' : `
							<div class="d-flex flex-wrap gap-2 mt-2">
								${atts.map((url: string) => {
									const ext = (url.split('.').pop() || '').toLowerCase();
									const isVideo = ['mp4', 'mov', 'webm'].includes(ext);
									return isVideo
										? `<button type="button" class="btn p-0 border rounded d-flex align-items-center justify-content-center bg-dark text-white media-preview-btn" data-url="${url}" data-title="Video Adjunto" style="width:48px;height:48px;"><i class="ri-play-circle-line fs-4"></i></button>`
										: `<button type="button" class="btn p-0 border rounded overflow-hidden media-preview-btn" data-url="${url}" data-title="Evidencia Adjunta" style="width:48px;height:48px;"><img src="${url}" style="width:100%;height:100%;object-fit:cover;" /></button>`;
								}).join('')}
							</div>`;

						const side = fromClient ? 'right' : 'left';
						return `
							<div class="cx-msg cx-msg-${side}">
								<div class="cx-bubble">
									<div class="cx-bubble-head"><strong>${author}</strong> · ${statusLabel}</div>
									<p class="cx-bubble-text">${h.note || 'Cambio de estado.'}</p>
									${attHtml}
									<span class="cx-bubble-time">${dateStr}</span>
								</div>
							</div>
						`;
					};

					// Chat PÚBLICO: lo que ve el cliente (notas externas + mensajes del propio cliente).
					// Chat INTERNO: solo lo ve el equipo.
					const publicItems = ticket.history.filter((h: any) => h.visibility === 'external' || h.from_client);
					const internalItems = ticket.history.filter((h: any) => h.visibility !== 'external' && !h.from_client);
					const publicHtml = publicItems.map(renderMsg).join('');
					const internalHtml = internalItems.map(renderMsg).join('');

					// Bloque de resolución (solo si el ticket fue finalizado con datos de resolución)
					const resolutionLabels: Record<string, string> = { rechazo: 'Rechazo', descuento: 'Descuento', reponer: 'Reponer' };
					const resolutionTones: Record<string, string> = { rechazo: 'danger', descuento: 'warning', reponer: 'success' };
					let resolutionHtml = '';
					if (ticket.resolution_type) {
						const rLabel = resolutionLabels[ticket.resolution_type] || ticket.resolution_type;
						const rTone = resolutionTones[ticket.resolution_type] || 'secondary';
						resolutionHtml = `
							<div class="mb-4">
								<h6 class="fw-bold text-muted text-uppercase small mb-2" style="letter-spacing: 0.05em;">Resolución del Caso</h6>
								<div class="p-3 bg-light rounded-3 border">
									<div class="mb-2">
										<span class="badge bg-${rTone}-subtle text-${rTone} rounded-pill px-3 py-1">${rLabel}</span>
									</div>
									<p class="mb-2 text-body" style="font-size: 0.85rem; line-height: 1.45;"><strong>Comentario principal:</strong><br>${ticket.resolution_main_comment || '—'}</p>
									${ticket.client_solution ? `<p class="mb-2 text-body" style="font-size: 0.85rem; line-height: 1.45;"><strong>Solución al cliente:</strong><br>${ticket.client_solution}</p>` : ''}
									${ticket.client_transaction_number ? `<p class="mb-2 text-body" style="font-size: 0.85rem; line-height: 1.45;"><strong>Nº Transacción Cliente:</strong><br>${ticket.client_transaction_number}</p>` : ''}
									${ticket.supplier_solution ? `<p class="mb-2 text-body" style="font-size: 0.85rem; line-height: 1.45;"><strong>Solución del proveedor:</strong><br>${ticket.supplier_solution}</p>` : ''}
									${ticket.supplier_transaction_number ? `<p class="mb-0 text-body" style="font-size: 0.85rem; line-height: 1.45;"><strong>Nº Transacción Proveedor:</strong><br>${ticket.supplier_transaction_number}</p>` : ''}
								</div>
							</div>
						`;
					}

					let editResolutionFormHtml = '';
					if (ticket.status === 'finalizada' || ticket.status === 'rechazada') {
						const isRechazo = ticket.resolution_type === 'rechazo' ? 'checked' : '';
						const isDescuento = ticket.resolution_type === 'descuento' ? 'checked' : '';
						const isReponer = ticket.resolution_type === 'reponer' ? 'checked' : '';
						
						editResolutionFormHtml = `
							<div class="card border border-light-subtle rounded-3 p-3.5 mb-4 shadow-sm" style="background-color: #fff;">
								<h6 class="fw-bold text-muted text-uppercase small mb-3" style="letter-spacing: 0.05em;"><i class="ri-edit-2-line me-1.5 text-secondary"></i>Editar Datos de Resolución</h6>
								
								<div class="mb-3">
									<label class="form-label small fw-bold text-muted">Tipo de resolución <span class="text-danger">*</span></label>
									<div class="d-flex gap-2 flex-wrap">
										<input type="radio" class="btn-check" name="edit-res-type" id="edit-type-rechazo" value="rechazo" ${isRechazo} autocomplete="off" />
										<label class="btn btn-outline-danger btn-sm rounded-pill px-3" for="edit-type-rechazo"><i class="ri-close-circle-line me-1"></i>Rechazo</label>

										<input type="radio" class="btn-check" name="edit-res-type" id="edit-type-descuento" value="descuento" ${isDescuento} autocomplete="off" />
										<label class="btn btn-outline-warning btn-sm rounded-pill px-3" for="edit-type-descuento"><i class="ri-percent-line me-1"></i>Descuento</label>

										<input type="radio" class="btn-check" name="edit-res-type" id="edit-type-reponer" value="reponer" ${isReponer} autocomplete="off" />
										<label class="btn btn-outline-success btn-sm rounded-pill px-3" for="edit-type-reponer"><i class="ri-refresh-line me-1"></i>Reponer</label>
									</div>
								</div>

								<div class="mb-3">
									<label for="edit-res-main-comment" class="form-label small fw-bold text-muted">Comentario principal (para reportes) <span class="text-danger">*</span></label>
									<textarea class="form-control form-control-sm" id="edit-res-main-comment" rows="2" placeholder="Resumen / motivo de la resolución...">${ticket.resolution_main_comment || ''}</textarea>
								</div>

								<div class="mb-3">
									<label for="edit-res-client-solution" class="form-label small fw-bold text-muted">Solución entregada al cliente</label>
									<textarea class="form-control form-control-sm" id="edit-res-client-solution" rows="2" placeholder="Qué se le dio / resolvió al cliente...">${ticket.client_solution || ''}</textarea>
								</div>

								<div class="mb-3">
									<label for="edit-res-supplier-solution" class="form-label small fw-bold text-muted">Solución del proveedor</label>
									<textarea class="form-control form-control-sm" id="edit-res-supplier-solution" rows="2" placeholder="Qué nos dio / resolvió el proveedor...">${ticket.supplier_solution || ''}</textarea>
								</div>

								<div class="row g-2 mb-3">
									<div class="col-6">
										<label for="edit-res-client-transaction" class="form-label small fw-bold text-muted">Transacción cliente</label>
										<input type="text" class="form-control form-control-sm" id="edit-res-client-transaction" value="${ticket.client_transaction_number || ''}" placeholder="Nº Transacción..." />
									</div>
									<div class="col-6">
										<label for="edit-res-supplier-transaction" class="form-label small fw-bold text-muted">Transacción proveedor</label>
										<input type="text" class="form-control form-control-sm" id="edit-res-supplier-transaction" value="${ticket.supplier_transaction_number || ''}" placeholder="Nº Transacción..." />
									</div>
								</div>

								<div class="alert alert-danger d-none small py-1.5 px-3 mb-3" id="edit-res-error"></div>

								<button type="button" class="btn btn-sm btn-dark rounded-pill px-3 w-100" id="edit-res-submit-btn">
									<i class="ri-save-line me-1"></i>Guardar Cambios de Resolución
								</button>
							</div>
						`;
					}

					// Register client message as read when modal is opened
					const lastClientMsg = (ticket.history || []).filter((h: any) => h.from_client).pop();
					if (lastClientMsg) {
						const clientKey = `${ticket.ticket_number}_${new Date(lastClientMsg.updated_at).getTime()}`;
						let readTickets: string[] = [];
						try { readTickets = JSON.parse(localStorage.getItem('read_client_tickets') || '[]'); } catch {}
						if (!readTickets.includes(clientKey)) {
							readTickets.push(clientKey);
							localStorage.setItem('read_client_tickets', JSON.stringify(readTickets));
							updateClientAlertDots();
						}
					}

					const isPdfReceipt = (ticket.sales_receipt_image || '').toLowerCase().endsWith('.pdf');
					const receiptBlock = isPdfReceipt
						? `
							<div class="col-6 col-md-4 mb-2">
								<span class="small text-muted fw-bold d-block mb-1 text-truncate" style="font-size: 0.73rem;">Factura de Compra</span>
								<button type="button" class="btn p-0 border rounded-3 overflow-hidden position-relative bg-light w-100 media-preview-btn d-block shadow-sm" data-url="${ticket.sales_receipt_image}" data-title="Factura de Compra (PDF)" style="height: 92px;">
									<div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center bg-danger bg-opacity-10 text-danger pb-3">
										<i class="ri-file-pdf-2-line fs-2 mb-1"></i>
										<span class="fw-bold" style="font-size: 0.7rem;">Factura PDF</span>
									</div>
									<div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white text-center py-1 small" style="font-size: 0.65rem; z-index: 10;">
										<i class="ri-aspect-ratio-line me-1"></i>Previsualizar PDF
									</div>
								</button>
							</div>`
						: `
							<div class="col-6 col-md-4 mb-2">
								<span class="small text-muted fw-bold d-block mb-1 text-truncate" style="font-size: 0.73rem;">Factura de Compra</span>
								<button type="button" class="btn p-0 border rounded-3 overflow-hidden position-relative bg-light w-100 media-preview-btn d-block shadow-sm" data-url="${ticket.sales_receipt_image}" data-title="Factura de Compra" style="height: 92px;">
									<img src="${ticket.sales_receipt_image}" alt="Factura" class="w-100 h-100 object-fit-cover" onerror="this.src='/img/logo-cx-ergonomic.webp'" />
									<div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white text-center py-1 small" style="font-size: 0.65rem; z-index: 10;">
										<i class="ri-aspect-ratio-line me-1"></i>Previsualizar
									</div>
								</button>
							</div>`;

					const snBlock = ticket.product_sn_image
						? `
							<div class="col-6 col-md-4 mb-2">
								<span class="small text-muted fw-bold d-block mb-1 text-truncate" style="font-size: 0.73rem;">Foto S/N Producto</span>
								<button type="button" class="btn p-0 border rounded-3 overflow-hidden position-relative bg-light w-100 media-preview-btn d-block shadow-sm" data-url="${ticket.product_sn_image}" data-title="Foto S/N Producto y Caja" style="height: 92px;">
									<img src="${ticket.product_sn_image}" alt="Foto S/N" class="w-100 h-100 object-fit-cover" onerror="this.src='/img/logo-cx-ergonomic.webp'" />
									<div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white text-center py-1 small" style="font-size: 0.65rem; z-index: 10;">
										<i class="ri-aspect-ratio-line me-1"></i>Previsualizar
									</div>
								</button>
							</div>`
						: '';

					const evidenceUrls = (ticket.evidence_video || '').split(',').filter(Boolean);
					const evidenceHtml = evidenceUrls.map((url: string, index: number) => {
						const ext = url.split('.').pop()?.toLowerCase();
						const isVideo = ['mp4', 'mov', 'webm'].includes(ext || '');
						if (isVideo) {
							return `
								<div class="col-6 col-md-4 mb-2">
									<span class="small text-muted fw-bold d-block mb-1 text-truncate" style="font-size: 0.73rem;">Evidencia ${index + 1} (Video)</span>
									<button type="button" class="btn p-0 border rounded-3 overflow-hidden position-relative bg-dark w-100 media-preview-btn d-block shadow-sm" data-url="${url}" data-title="Evidencia ${index + 1} (Video)" style="height: 92px;">
										<video src="${url}" class="w-100 h-100 object-fit-cover" preload="metadata"></video>
										<div class="position-absolute top-50 start-50 translate-middle text-white fs-3"><i class="ri-play-circle-fill"></i></div>
										<div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white text-center py-1 small" style="font-size: 0.65rem; z-index: 10;">
											<i class="ri-aspect-ratio-line me-1"></i>Previsualizar
										</div>
									</button>
								</div>
							`;
						} else {
							return `
								<div class="col-6 col-md-4 mb-2">
									<span class="small text-muted fw-bold d-block mb-1 text-truncate" style="font-size: 0.73rem;">Evidencia ${index + 1} (Foto)</span>
									<button type="button" class="btn p-0 border rounded-3 overflow-hidden position-relative bg-light w-100 media-preview-btn d-block shadow-sm" data-url="${url}" data-title="Evidencia ${index + 1}" style="height: 92px;">
										<img src="${url}" alt="Evidencia" class="w-100 h-100 object-fit-cover" onerror="this.src='/img/logo-cx-ergonomic.webp'" />
										<div class="position-absolute bottom-0 start-0 w-100 bg-dark bg-opacity-75 text-white text-center py-1 small" style="font-size: 0.65rem; z-index: 10;">
											<i class="ri-aspect-ratio-line me-1"></i>Previsualizar
										</div>
									</button>
								</div>
							`;
						}
					}).join('');

					modalBody.innerHTML = `
						<div class="row g-4">
							<!-- Columna izquierda: Datos del caso, Evidencias, Descripción e iOS Checklist -->
							<div class="col-12 col-xl-5">
								
								<!-- DATOS DE LA SOLICITUD -->
								<div class="card border border-light-subtle rounded-3 p-3.5 mb-4 shadow-sm">
									<h6 class="fw-bold text-muted text-uppercase small mb-3" style="letter-spacing: 0.05em;"><i class="ri-information-line me-1.5 text-secondary"></i>Datos de la Solicitud</h6>
									<table class="table table-sm table-borderless mb-0" style="font-size: 0.85rem;">
										<tbody>
											<tr>
												<td class="text-muted py-1" style="width: 120px;">Cliente:</td>
												<td class="fw-bold text-dark py-1">${ticket.customer_details.name}</td>
											</tr>
											<tr>
												<td class="text-muted py-1">Identificación:</td>
												<td class="text-dark py-1">${ticket.customer_details.ci}</td>
											</tr>
											<tr>
												<td class="text-muted py-1">Teléfono:</td>
												<td class="text-dark py-1">${ticket.customer_details.phone}</td>
											</tr>
											<tr>
												<td class="text-muted py-1">Ciudad:</td>
												<td class="text-dark py-1">${ticket.customer_details.city || '—'}</td>
											</tr>
											<tr>
												<td class="text-muted py-1">Serial (S/N):</td>
												<td class="text-dark fw-bold py-1">${ticket.product_serial_number}</td>
											</tr>
											<tr>
												<td class="text-muted py-1">Producto:</td>
												<td class="text-dark py-1">${ticket.product_name || '—'}</td>
											</tr>
											<tr>
												<td class="text-muted py-1">Marca:</td>
												<td class="text-dark py-1">${ticket.product_brand || '—'}</td>
											</tr>
											${ticket.store_manager_name ? `
											<tr>
												<td class="text-muted py-1">Encargado:</td>
												<td class="text-dark py-1">${ticket.store_manager_name} ${ticket.store_manager_phone ? `(${ticket.store_manager_phone})` : ''}</td>
											</tr>
											` : ''}
											<tr>
												<td class="text-muted py-1">Registrado:</td>
												<td class="text-dark py-1">${ticket.createdAtStr}</td>
											</tr>
										</tbody>
									</table>
								</div>

								<!-- DESCRIPCIÓN DEL INCONVENIENTE -->
								<div class="card border border-light-subtle rounded-3 p-3.5 mb-4 shadow-sm">
									<h6 class="fw-bold text-muted text-uppercase small mb-2" style="letter-spacing: 0.05em;"><i class="ri-chat-voice-line me-1.5 text-secondary"></i>Descripción del Inconveniente</h6>
									<div class="p-3 bg-light rounded-3 text-body border" style="font-size: 0.88rem; line-height: 1.5; white-space: pre-line;">
										${ticket.issue_description}
									</div>
								</div>

								<!-- RESOLUCIÓN DEL CASO (si aplica) -->
								${resolutionHtml}

								<!-- EVIDENCIAS ADJUNTAS -->
								<div class="card border border-light-subtle rounded-3 p-3.5 mb-4 shadow-sm">
									<div class="d-flex justify-content-between align-items-center mb-3">
										<h6 class="fw-bold text-muted text-uppercase small mb-0" style="letter-spacing: 0.05em;"><i class="ri-attachment-line me-1.5 text-secondary"></i>Evidencias y Archivos Adjuntos</h6>
										<label class="btn btn-xs btn-outline-dark rounded-pill px-2.5 py-1 mb-0 fw-semibold d-inline-flex align-items-center gap-1" style="font-size: 0.72rem; cursor: pointer;" title="Subir nueva evidencia a este ticket">
											<i class="ri-add-line"></i> Añadir Evidencia
											<input type="file" id="admin-add-evidence-input" class="d-none" accept="image/*,video/*,.pdf" multiple />
										</label>
									</div>
									<div class="row g-2">
										${receiptBlock}
										${snBlock}
										${evidenceHtml}
									</div>
								</div>

								<!-- PASOS OBLIGATORIOS (Estilo iPhone Notes) -->
								<div class="card border border-light-subtle rounded-3 p-3.5 mb-4 shadow-sm" style="background-color: #f8f9fa;">
									<h6 class="fw-bold text-muted text-uppercase small mb-3" style="letter-spacing: 0.05em;"><i class="ri-checkbox-multiple-line me-1.5 text-secondary"></i>Pasos Obligatorios para Resolución</h6>
									<div class="d-flex flex-column gap-3">
										<div class="d-flex align-items-center">
											<input class="ios-checkbox-input" type="checkbox" id="step-left-at-branch" ${ticket.step_left_at_branch ? 'checked' : ''} />
											<label class="ios-checkbox-label ms-3 fw-semibold text-dark small" for="step-left-at-branch" style="cursor: pointer;">Producto dejado en la sucursal</label>
										</div>
										<div class="d-flex align-items-center">
											<input class="ios-checkbox-input" type="checkbox" id="step-sent-to-distributor" ${ticket.step_sent_to_distributor ? 'checked' : ''} />
											<label class="ios-checkbox-label ms-3 fw-semibold text-dark small" for="step-sent-to-distributor" style="cursor: pointer;">Producto mandado con distribuidor</label>
										</div>
										<div class="d-flex align-items-center">
											<input class="ios-checkbox-input" type="checkbox" id="step-resolved" ${ticket.step_resolved ? 'checked' : ''} />
											<label class="ios-checkbox-label ms-3 fw-semibold text-dark small" for="step-resolved" style="cursor: pointer;">Producto dado solución</label>
										</div>
									</div>
									<div id="steps-error-message" class="alert alert-danger d-none small py-1.5 px-3 mt-3 mb-0"></div>
								</div>

								<!-- FORMULARIO DE EDICIÓN DE RESOLUCIÓN -->
								${editResolutionFormHtml}

							</div>

							<!-- Columna derecha: Historial & Comentarios (Chats) -->
							<div class="col-12 col-xl-7">
								<div class="cx-comments h-100 d-flex flex-column shadow-sm" style="border-top: 4px solid #212529 !important;">
									<div class="cx-comments-head mb-3">
										<h6 class="fw-bold text-uppercase small mb-1 text-dark" style="letter-spacing: 0.05em;"><i class="ri-message-3-line me-1.5 text-secondary"></i>Historial &amp; Comentarios</h6>
										<p class="text-muted mb-0" style="font-size: 0.78rem;">El chat <strong>Público</strong> lo ve el cliente en su seguimiento. El <strong>Interno</strong> solo lo ve el equipo.</p>
									</div>
									<input type="hidden" id="note-ticket-number" value="${ticket.ticket_number}" />
									
									<div class="row g-3 flex-grow-1">
										<!-- Chat Público -->
										<div class="col-12 col-md-6 d-flex flex-column">
											<div class="cx-chat cx-chat-public flex-grow-1 h-100">
												<div class="cx-chat-head"><i class="ri-eye-line"></i><div><span class="cx-chat-title">Público</span><span class="cx-chat-sub">Lo ve el cliente</span></div></div>
												<div class="cx-chat-body" style="height: 460px;">${publicHtml || '<p class="cx-chat-empty">Aún no hay mensajes para el cliente.</p>'}</div>
												<form class="cx-chat-input mt-auto p-2.5 border-top bg-white rounded-bottom d-flex flex-column gap-2" data-visibility="external">
													<div class="chat-file-previews d-flex flex-wrap gap-2 p-2 bg-light rounded-3 border d-none"></div>
													<div class="d-flex align-items-center gap-2">
														<label class="btn btn-sm btn-light border text-secondary rounded-circle d-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 36px; height: 36px; cursor: pointer;" title="Adjuntar fotos, videos o PDFs">
															<i class="ri-attachment-2 fs-5"></i>
															<input type="file" class="d-none chat-file-input" accept="image/*,video/*,.pdf" multiple />
														</label>
														<textarea class="form-control form-control-sm border-light-subtle rounded-3 py-1.5 px-3 shadow-none flex-grow-1" rows="1" placeholder="Mensaje para el cliente..." style="resize: none; min-height: 36px; font-size: 0.83rem; line-height: 1.4;"></textarea>
														<button type="submit" class="btn btn-sm btn-info text-white rounded-circle d-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 36px; height: 36px;" title="Enviar mensaje">
															<i class="ri-send-plane-fill fs-5"></i>
														</button>
													</div>
												</form>
											</div>
										</div>
										<!-- Chat Interno -->
										<div class="col-12 col-md-6 d-flex flex-column">
											<div class="cx-chat cx-chat-internal flex-grow-1 h-100">
												<div class="cx-chat-head"><i class="ri-lock-line"></i><div><span class="cx-chat-title">Interno</span><span class="cx-chat-sub">Solo el equipo</span></div></div>
												<div class="cx-chat-body" style="height: 460px;">${internalHtml || '<p class="cx-chat-empty">Aún no hay notas internas.</p>'}</div>
												<form class="cx-chat-input mt-auto p-2.5 border-top bg-white rounded-bottom d-flex flex-column gap-2" data-visibility="internal">
													<div class="chat-file-previews d-flex flex-wrap gap-2 p-2 bg-light rounded-3 border d-none"></div>
													<div class="d-flex align-items-center gap-2">
														<label class="btn btn-sm btn-light border text-secondary rounded-circle d-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 36px; height: 36px; cursor: pointer;" title="Adjuntar fotos, videos o PDFs">
															<i class="ri-attachment-2 fs-5"></i>
															<input type="file" class="d-none chat-file-input" accept="image/*,video/*,.pdf" multiple />
														</label>
														<textarea class="form-control form-control-sm border-light-subtle rounded-3 py-1.5 px-3 shadow-none flex-grow-1" rows="1" placeholder="Nota interna del equipo..." style="resize: none; min-height: 36px; font-size: 0.83rem; line-height: 1.4;"></textarea>
														<button type="submit" class="btn btn-sm btn-dark text-white rounded-circle d-flex align-items-center justify-content-center p-0 flex-shrink-0" style="width: 36px; height: 36px;" title="Guardar nota interna">
															<i class="ri-send-plane-fill fs-5"></i>
														</button>
													</div>
												</form>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					`;
					const steps = ['step-left-at-branch', 'step-sent-to-distributor', 'step-resolved'];
					steps.forEach(stepId => {
						const checkbox = modalBody.querySelector(`#${stepId}`) as HTMLInputElement | null;
						checkbox?.addEventListener('change', async () => {
							const errorEl = modalBody.querySelector('#steps-error-message') as HTMLElement | null;
							if (errorEl) errorEl.classList.add('d-none');

							try {
								const res = await fetch('/api/tickets/update-steps', {
									method: 'POST',
									headers: { 'content-type': 'application/json' },
									body: JSON.stringify({
										ticketNumber: ticket.ticket_number,
										step_left_at_branch: (modalBody.querySelector('#step-left-at-branch') as HTMLInputElement).checked,
										step_sent_to_distributor: (modalBody.querySelector('#step-sent-to-distributor') as HTMLInputElement).checked,
										step_resolved: (modalBody.querySelector('#step-resolved') as HTMLInputElement).checked,
									})
								});
								const data = await res.json();
								if (!res.ok) throw new Error(data.error || 'Error al actualizar los pasos');

								// @ts-ignore
								const tIdx = window.ALL_TICKETS.findIndex((t: any) => t.ticket_number === ticket.ticket_number);
								if (tIdx !== -1) {
									// @ts-ignore
									window.ALL_TICKETS[tIdx].step_left_at_branch = data.ticket.step_left_at_branch;
									// @ts-ignore
									window.ALL_TICKETS[tIdx].step_sent_to_distributor = data.ticket.step_sent_to_distributor;
									// @ts-ignore
									window.ALL_TICKETS[tIdx].step_resolved = data.ticket.step_resolved;
								}
							} catch (err: any) {
								console.error(err);
								if (errorEl) {
									errorEl.textContent = 'Error: ' + err.message;
									errorEl.classList.remove('d-none');
								}
								// Revert UI check state on error
								checkbox.checked = !checkbox.checked;
							}
						});
					});

					if (ticket.status === 'finalizada' || ticket.status === 'rechazada') {
						const editSubmitBtn = modalBody.querySelector('#edit-res-submit-btn');
						editSubmitBtn?.addEventListener('click', async () => {
							const errorEl = modalBody.querySelector('#edit-res-error') as HTMLElement | null;
							if (errorEl) errorEl.classList.add('d-none');

							const typeEl = modalBody.querySelector('input[name="edit-res-type"]:checked') as HTMLInputElement | null;
							const mainComment = (modalBody.querySelector('#edit-res-main-comment') as HTMLTextAreaElement).value.trim();
							const clientSolution = (modalBody.querySelector('#edit-res-client-solution') as HTMLTextAreaElement).value.trim();
							const supplierSolution = (modalBody.querySelector('#edit-res-supplier-solution') as HTMLTextAreaElement).value.trim();
							const clientTransactionNumber = (modalBody.querySelector('#edit-res-client-transaction') as HTMLInputElement).value.trim();
							const supplierTransactionNumber = (modalBody.querySelector('#edit-res-supplier-transaction') as HTMLInputElement).value.trim();

							if (!typeEl) {
								if (errorEl) {
									errorEl.textContent = 'Selecciona un tipo de resolución.';
									errorEl.classList.remove('d-none');
								}
								return;
							}
							if (!mainComment) {
								if (errorEl) {
									errorEl.textContent = 'El comentario principal es obligatorio.';
									errorEl.classList.remove('d-none');
								}
								return;
							}
							if (typeEl.value !== 'rechazo' && !clientSolution && !supplierSolution) {
								if (errorEl) {
									errorEl.textContent = 'Registra al menos una solución (al cliente o del proveedor).';
									errorEl.classList.remove('d-none');
								}
								return;
							}

							try {
								if (editSubmitBtn) {
									(editSubmitBtn as HTMLButtonElement).disabled = true;
									editSubmitBtn.textContent = 'Guardando...';
								}

								const res = await fetch('/api/tickets/update-status', {
									method: 'POST',
									headers: { 'content-type': 'application/json' },
									body: JSON.stringify({
										ticketNumber: ticket.ticket_number,
										status: ticket.status,
										orderedNumbers: [],
										resolutionType: typeEl.value,
										mainComment,
										clientSolution,
										supplierSolution,
										clientTransactionNumber,
										supplierTransactionNumber,
									})
								});
								const data = await res.json();
								if (!res.ok) throw new Error(data.error || 'Error al guardar los cambios');

								window.location.reload();
							} catch (err: any) {
								console.error(err);
								if (errorEl) {
									errorEl.textContent = err.message;
									errorEl.classList.remove('d-none');
								}
								if (editSubmitBtn) {
									(editSubmitBtn as HTMLButtonElement).disabled = false;
									editSubmitBtn.innerHTML = '<i class="ri-save-line me-1"></i>Guardar Cambios de Resolución';
								}
							}
						});
					}

					// Media preview click handlers
					modalBody.querySelectorAll('.media-preview-btn').forEach(btn => {
						btn.addEventListener('click', (e) => {
							e.preventDefault();
							e.stopPropagation();
							const url = btn.getAttribute('data-url');
							const title = btn.getAttribute('data-title') || 'Previsualización';
							if (url) openMediaPreviewModal(url, title);
						});
					});

					// Conectar botón de impresión de ticket
					const printBtn = document.getElementById('modal-print-ticket-btn');
					if (printBtn) {
						printBtn.onclick = () => printRmaSticker(ticket);
					}

					// Show modal using Bootstrap modal API
					const modalEl = document.getElementById('ticketDetailsModal');
					// @ts-ignore
					const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
					modal.show();

					// Auto-scroll de cada chat hasta el último mensaje
					modalBody.querySelectorAll('.cx-chat-body').forEach((b) => { b.scrollTop = b.scrollHeight; });

					// Add evidence handler for admins inside details modal
					const addEvInput = modalBody.querySelector('#admin-add-evidence-input') as HTMLInputElement | null;
					addEvInput?.addEventListener('change', async () => {
						const files = addEvInput.files;
						if (!files || files.length === 0) return;

						try {
							showToast('Subiendo evidencias...', 'info');
							for (let i = 0; i < files.length; i++) {
								const file = files[i];
								const kind = file.type.startsWith('video/') ? 'video' : 'receipt';
								const url = await uploadFile(file, kind);

								const res = await fetch('/api/tickets/add-evidence', {
									method: 'POST',
									headers: { 'content-type': 'application/json' },
									body: JSON.stringify({ ticketNumber: ticket.ticket_number, evidenceUrl: url }),
								});
								const data = await res.json();
								if (!res.ok) throw new Error(data.error || 'Error al guardar evidencia');

								ticket.evidence_video = data.evidence_video;
								// @ts-ignore
								const tIdx = window.ALL_TICKETS.findIndex((t: any) => t.ticket_number === ticket.ticket_number);
								if (tIdx !== -1) {
									// @ts-ignore
									window.ALL_TICKETS[tIdx].evidence_video = data.evidence_video;
								}
							}
							showToast('Evidencias añadidas con éxito', 'success');
							openTicketDetailsModal(ticket);
						} catch (err: any) {
							console.error(err);
							showToast('Error al añadir evidencia: ' + err.message, 'danger');
						}
					});

					// Un mismo handler para los dos chats: visibilidad y adjuntos
					const tNumInput = document.getElementById('note-ticket-number') as HTMLInputElement | null;
					modalBody.querySelectorAll('.cx-chat-input').forEach((formEl) => {
						const form = formEl as HTMLFormElement;
						const fileInput = form.querySelector('.chat-file-input') as HTMLInputElement | null;
						const previewsContainer = form.querySelector('.chat-file-previews') as HTMLElement | null;
						const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
						const textarea = form.querySelector('textarea') as HTMLTextAreaElement | null;

						let attachments: string[] = [];

						function renderChatPreviews() {
							if (!previewsContainer) return;
							if (attachments.length === 0) {
								previewsContainer.classList.add('d-none');
								previewsContainer.innerHTML = '';
								return;
							}
							previewsContainer.classList.remove('d-none');
							previewsContainer.innerHTML = attachments.map((url, idx) => {
								const ext = (url.split('.').pop() || '').toLowerCase();
								const isVideo = ['mp4', 'mov', 'webm'].includes(ext);
								const isPdf = ext === 'pdf';
								return `
									<div class="position-relative d-inline-block border rounded-3 overflow-hidden bg-white shadow-sm" style="width: 52px; height: 52px;">
										${isVideo 
											? `<div class="w-100 h-100 bg-dark text-white rounded d-flex flex-column align-items-center justify-content-center" style="font-size:0.6rem;"><i class="ri-play-circle-fill fs-5"></i><span>Video</span></div>` 
											: isPdf 
												? `<div class="w-100 h-100 bg-danger-subtle text-danger rounded d-flex flex-column align-items-center justify-content-center" style="font-size:0.6rem;"><i class="ri-file-pdf-line fs-5"></i><span>PDF</span></div>`
												: `<img src="${url}" class="w-100 h-100 object-fit-cover" />`}
										<button type="button" class="btn btn-danger btn-xs position-absolute top-0 end-0 p-0 rounded-circle d-flex align-items-center justify-content-center delete-chat-att" data-idx="${idx}" style="width: 18px; height: 18px; transform: translate(25%, -25%); z-index: 10;" title="Quitar">
											<i class="ri-close-line" style="font-size: 0.75rem;"></i>
										</button>
									</div>
								`;
							}).join('');

							previewsContainer.querySelectorAll('.delete-chat-att').forEach(b => {
								b.addEventListener('click', (e) => {
									e.preventDefault();
									e.stopPropagation();
									const idx = parseInt(b.getAttribute('data-idx') || '0', 10);
									attachments.splice(idx, 1);
									renderChatPreviews();
								});
							});
						}

						fileInput?.addEventListener('change', async () => {
							const files = fileInput.files;
							if (!files || files.length === 0) return;

							try {
								if (btn) btn.disabled = true;
								for (let i = 0; i < files.length; i++) {
									if (attachments.length >= 5) { showToast('Máximo 5 archivos por mensaje', 'warning'); break; }
									const file = files[i];
									const kind = file.type.startsWith('video/') ? 'video' : 'receipt';
									const url = await uploadFile(file, kind);
									attachments.push(url);
									renderChatPreviews();
								}
							} catch (err: any) {
								showToast('Error al subir adjunto: ' + err.message, 'danger');
							} finally {
								if (btn) btn.disabled = false;
								fileInput.value = '';
							}
						});

						form.addEventListener('submit', async (ev) => {
							ev.preventDefault();
							const note = (textarea?.value || '').trim();
							if ((!note && attachments.length === 0) || !tNumInput) return;
							const visibility = form.getAttribute('data-visibility') === 'external' ? 'external' : 'internal';

							try {
								if (btn) btn.disabled = true;
								const res = await fetch('/api/tickets/add-comment', {
									method: 'POST',
									headers: { 'content-type': 'application/json' },
									body: JSON.stringify({
										ticketNumber: tNumInput.value,
										note: note || (attachments.length > 0 ? 'Archivos adjuntos enviados.' : ''),
										visibility,
										attachments,
									})
								});
								const data = await res.json();
								if (!res.ok) throw new Error(data.error || 'Error al guardar comentario');

								// Update ticket locally and re-render modal
								// @ts-ignore
								const tIndex = window.ALL_TICKETS.findIndex((t: any) => t.ticket_number === tNumInput.value);
								if (tIndex !== -1) {
									// @ts-ignore
									window.ALL_TICKETS[tIndex].history.push(data.comment);
									// @ts-ignore
									openTicketDetailsModal(window.ALL_TICKETS[tIndex]);
								}
							} catch (err: any) {
								console.error(err);
								showToast('Error: ' + err.message, 'danger');
								if (btn) btn.disabled = false;
							}
						});
					});
				}

				// ---- Rechazo de solicitud (NO borra: queda como registro con su motivo) ----
				function normalizePhoneClient(raw: string) {
					let digits = (raw || '').replace(/\D/g, '');
					if (digits.length === 8) digits = '591' + digits;
					return digits;
				}

				let pendingReject: { ticketNumber: string; status: string; orderedNumbers: any[] } | null = null;
				let rejectSubmitting = false;
				const rejectModalEl = document.getElementById('rejectModal');

				function openRejectModal(ticketNumber: string, status: string, orderedNumbers: any[]) {
					pendingReject = { ticketNumber, status, orderedNumbers };
					rejectSubmitting = false;

					const numEl = document.getElementById('reject-ticket-number');
					if (numEl) numEl.textContent = ticketNumber;
					(document.getElementById('reject-reason') as HTMLTextAreaElement).value = '';
					document.getElementById('reject-error')?.classList.add('d-none');
					// @ts-ignore
					bootstrap.Modal.getOrCreateInstance(rejectModalEl).show();
				}

				// Si se cierra sin rechazar, recargar para revertir el arrastre visual.
				rejectModalEl?.addEventListener('hidden.bs.modal', () => {
					if (pendingReject && !rejectSubmitting) {
						window.location.reload();
					}
				});

				document.querySelectorAll('.reject-ticket-btn').forEach(btn => {
					btn.addEventListener('click', (e) => {
						e.stopPropagation();
						const ticketNumber = btn.getAttribute('data-ticket-number');
						if (ticketNumber) {
							openRejectModal(ticketNumber, 'rechazada', []);
						}
					});
				});

				document.getElementById('reject-submit-btn')?.addEventListener('click', async () => {
					if (!pendingReject) return;
					const errEl = document.getElementById('reject-error');
					const reason = (document.getElementById('reject-reason') as HTMLTextAreaElement).value.trim();
					if (!reason) {
						if (errEl) { errEl.textContent = 'Escribe el motivo del rechazo.'; errEl.classList.remove('d-none'); }
						return;
					}
					const btn = document.getElementById('reject-submit-btn') as HTMLButtonElement;
					try {
						rejectSubmitting = true;
						btn.disabled = true;
						btn.textContent = 'Rechazando...';
						const res = await fetch('/api/tickets/update-status', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({
								ticketNumber: pendingReject.ticketNumber,
								status: pendingReject.status,
								orderedNumbers: pendingReject.orderedNumbers,
								resolutionType: 'rechazo',
								mainComment: reason,
							}),
						});
						const data = await res.json();
						if (!res.ok) throw new Error(data.error || 'Error al rechazar el ticket');

						// Abrir WhatsApp con el motivo (plantilla configurable en Ajustes)
						// @ts-ignore
						const ticket = window.ALL_TICKETS.find((t: any) => t.ticket_number === pendingReject.ticketNumber);
						// @ts-ignore
						const cfg = window.CX_WA || { rechazo: '', trackingBase: '' };
						if (ticket && cfg.rechazo) {
							const base = cfg.trackingBase || '';
							const trackUrl = base ? `${base}${base.includes('?') ? '&' : '?'}ticket=${encodeURIComponent(ticket.ticket_number)}` : '';
							const msg = cfg.rechazo
								.replace(/\{ticket\}/g, ticket.ticket_number)
								.replace(/\{cliente\}/g, ticket.customer_details.name)
								.replace(/\{url\}/g, trackUrl)
								.replace(/\{motivo\}/g, reason);
							const phone = normalizePhoneClient(ticket.store_manager_phone || ticket.customer_details.phone);
							window.open(`https://wa.me/${phone}?text=${encodeURIComponent(msg)}`, '_blank');
						}
						window.location.reload();
					} catch (err: any) {
						rejectSubmitting = false;
						btn.disabled = false;
						btn.innerHTML = '<i class="ri-close-circle-line me-1"></i>Rechazar y enviar WhatsApp';
						if (errEl) { errEl.textContent = err.message; errEl.classList.remove('d-none'); }
					}
				});

				// Archive ticket button handler
				document.querySelectorAll('.archive-ticket-btn').forEach(btn => {
					btn.addEventListener('click', async (e) => {
						e.stopPropagation();
						const ticketNumber = btn.getAttribute('data-ticket-number');
						showConfirmModal(
							'Archivar Ticket',
							`¿Estás seguro de que deseas archivar el ticket #${ticketNumber}?`,
							async () => {
								try {
									const res = await fetch('/api/tickets/archive', {
										method: 'POST',
										headers: { 'content-type': 'application/json' },
										body: JSON.stringify({ ticketNumber, archived: true })
									});
									const data = await res.json();
									if (!res.ok) throw new Error(data.error || 'Error al archivar');
									window.location.reload();
								} catch (err: any) {
									showToast('Error: ' + err.message, 'danger');
								}
							}
						);
					});
				});

				// Unarchive ticket button handler
				document.querySelectorAll('.unarchive-ticket-btn').forEach(btn => {
					btn.addEventListener('click', async (e) => {
						e.stopPropagation();
						const ticketNumber = btn.getAttribute('data-ticket-number');
						showConfirmModal(
							'Desarchivar Ticket',
							`¿Deseas desarchivar el ticket #${ticketNumber} para regresarlo al flujo activo?`,
							async () => {
								try {
									const res = await fetch('/api/tickets/archive', {
										method: 'POST',
										headers: { 'content-type': 'application/json' },
										body: JSON.stringify({ ticketNumber, archived: false })
									});
									const data = await res.json();
									if (!res.ok) throw new Error(data.error || 'Error al desarchivar');
									window.location.reload();
								} catch (err: any) {
									showToast('Error: ' + err.message, 'danger');
								}
							}
						);
					});
				});

				// Table row click handlers to open details modal
				document.querySelectorAll('.archived-ticket-row, .archived-preview-item').forEach(row => {
					row.addEventListener('click', (e) => {
						const target = e.target as HTMLElement;
						if (target.closest('.unarchive-ticket-btn')) return;

						const tNum = row.getAttribute('data-ticket-number');
						// @ts-ignore
						const ticket = window.ALL_TICKETS.find(t => t.ticket_number === tNum);
						if (ticket) {
							openTicketDetailsModal(ticket);
						}
					});
				});

				// Client-Side Pagination & Search for Archived Tickets Table
				let archivedPage = 1;
				const archivedPageSize = 5;
				let filteredArchivedRows: Element[] = [];

				function updateArchivedPagination() {
					const rows = document.querySelectorAll('.archived-ticket-row');
					const query = (document.getElementById('search-archived-input') as HTMLInputElement)?.value.toLowerCase().trim() || '';
					const filterStatus = (document.getElementById('filter-archived-status') as HTMLSelectElement)?.value || '';
					const filterStart = (document.getElementById('filter-archived-start') as HTMLInputElement)?.value || '';
					const filterEnd = (document.getElementById('filter-archived-end') as HTMLInputElement)?.value || '';
					
					filteredArchivedRows = [];
					rows.forEach(row => {
						const ticketNum = row.getAttribute('data-ticket-number')?.toLowerCase() || '';
						const clientName = row.getAttribute('data-client-name')?.toLowerCase() || '';
						const status = (row as HTMLElement).getAttribute('data-status') || '';
						const createdAt = (row as HTMLElement).getAttribute('data-created-at') || '';
						const dateOnly = createdAt ? createdAt.substring(0, 10) : '';
						
						let matches = true;
						
						// Query match
						if (query && !ticketNum.includes(query) && !clientName.includes(query)) {
							matches = false;
						}
						
						// Status match
						if (filterStatus && status !== filterStatus) {
							matches = false;
						}
						
						// Start Date match
						if (filterStart && dateOnly < filterStart) {
							matches = false;
						}
						
						// End Date match
						if (filterEnd && dateOnly > filterEnd) {
							matches = false;
						}
						
						if (matches) {
							filteredArchivedRows.push(row);
						} else {
							(row as HTMLElement).style.setProperty('display', 'none', 'important');
						}
					});
					
					// Calculate pagination
					const total = filteredArchivedRows.length;
					const totalPages = Math.max(Math.ceil(total / archivedPageSize), 1);
					
					if (archivedPage > totalPages) {
						archivedPage = totalPages;
					}
					
					// Show/hide rows based on current page
					const startIdx = (archivedPage - 1) * archivedPageSize;
					const endIdx = startIdx + archivedPageSize;
					
					filteredArchivedRows.forEach((row, idx) => {
						if (idx >= startIdx && idx < endIdx) {
							(row as HTMLElement).style.setProperty('display', '', 'important');
						} else {
							(row as HTMLElement).style.setProperty('display', 'none', 'important');
						}
					});
					
					// Show/hide no results row
					const noResultsRow = document.querySelector('.no-results-row');
					if (noResultsRow) {
						if (total === 0 && rows.length > 0) {
							noResultsRow.classList.remove('d-none');
						} else {
							noResultsRow.classList.add('d-none');
						}
					}
					
					// Update page indicator text
					const indicator = document.getElementById('archived-page-indicator');
					if (indicator) {
						indicator.textContent = `Página ${archivedPage} de ${totalPages} (${total} registros)`;
					}
					
					// Enable/disable buttons
					const prevBtn = document.getElementById('archived-prev-btn') as HTMLButtonElement;
					const nextBtn = document.getElementById('archived-next-btn') as HTMLButtonElement;
					if (prevBtn) prevBtn.disabled = archivedPage === 1;
					if (nextBtn) nextBtn.disabled = archivedPage === totalPages;
				}

				// Event listeners for pagination buttons
				document.getElementById('archived-prev-btn')?.addEventListener('click', () => {
					if (archivedPage > 1) {
						archivedPage--;
						updateArchivedPagination();
					}
				});

				document.getElementById('archived-next-btn')?.addEventListener('click', () => {
					const totalPages = Math.max(Math.ceil(filteredArchivedRows.length / archivedPageSize), 1);
					if (archivedPage < totalPages) {
						archivedPage++;
						updateArchivedPagination();
					}
				});

				// Event listener for search input on archived tickets
				document.getElementById('search-archived-input')?.addEventListener('input', () => {
					archivedPage = 1; // reset to first page on search
					updateArchivedPagination();
				});

				// Event listeners for status and date filters
				document.getElementById('filter-archived-status')?.addEventListener('change', () => {
					archivedPage = 1;
					updateArchivedPagination();
				});
				document.getElementById('filter-archived-start')?.addEventListener('change', () => {
					archivedPage = 1;
					updateArchivedPagination();
				});
				document.getElementById('filter-archived-end')?.addEventListener('change', () => {
					archivedPage = 1;
					updateArchivedPagination();
				});

				// Helper function to export tickets to Excel (HTML format supporting embedded images)
				function exportToExcelHTML(filename: string, tickets: any[]) {
					const statusMap: Record<string, string> = {
						'recibida': 'Nueva solicitud',
						'en revision': 'En revisión',
						'en proceso': 'En proceso',
						'finalizada': 'Finalizada',
						'rechazada': 'Rechazada'
					};
					const resMap: Record<string, string> = {
						'rechazo': 'Rechazo',
						'descuento': 'Descuento',
						'reponer': 'Reponer'
					};

					let tableRows = '';
					tickets.forEach((t: any) => {
						const details = t.customer_details || {};
						
						// Process receipt image/pdf
						let receiptHtml = '—';
						if (t.sales_receipt_image) {
							const absReceiptUrl = t.sales_receipt_image.startsWith('http') 
								? t.sales_receipt_image 
								: window.location.origin + t.sales_receipt_image;
							receiptHtml = `<a href="${absReceiptUrl}" target="_blank" style="color:#0d6efd; text-decoration:underline;">${absReceiptUrl}</a>`;
						}

						// Process S/N photo
						let snHtml = '—';
						if (t.product_sn_image) {
							const absSnUrl = t.product_sn_image.startsWith('http') 
								? t.product_sn_image 
								: window.location.origin + t.product_sn_image;
							snHtml = `<a href="${absSnUrl}" target="_blank" style="color:#0d6efd; text-decoration:underline;">${absSnUrl}</a>`;
						}

						// Process evidence files (images or videos) - Formato 1 : link, 2 : link
						let evidenceHtml = '—';
						if (t.evidence_video) {
							const urls = t.evidence_video.split(',').filter(Boolean);
							if (urls.length === 1) {
								const absUrl = urls[0].startsWith('http') ? urls[0] : window.location.origin + urls[0];
								evidenceHtml = `<a href="${absUrl}" target="_blank" style="color:#0d6efd; text-decoration:underline;">${absUrl}</a>`;
							} else {
								evidenceHtml = urls.map((url: string, idx: number) => {
									const absUrl = url.startsWith('http') ? url : window.location.origin + url;
									return `<div>${idx + 1} : <a href="${absUrl}" target="_blank" style="color:#0d6efd; text-decoration:underline;">${absUrl}</a></div>`;
								}).join('');
							}
						}

						tableRows += `
							<tr>
								<td style="mso-number-format:'\\@'; font-weight:bold;">${t.ticket_number}</td>
								<td>${details.name || ''}</td>
								<td style="mso-number-format:'\\@';">${details.ci || ''}</td>
								<td style="mso-number-format:'\\@';">${details.phone || ''}</td>
								<td>${details.city || ''}</td>
								<td>${t.product_name || ''}</td>
								<td>${t.product_brand || ''}</td>
								<td style="mso-number-format:'\\@';">${t.product_serial_number || ''}</td>
								<td>${statusMap[t.status] || t.status}</td>
								<td>${resMap[t.resolution_type] || t.resolution_type || '—'}</td>
								<td>${t.resolution_main_comment || '—'}</td>
								<td>${t.client_solution || '—'}</td>
								<td>${t.client_transaction_number || '—'}</td>
								<td>${t.supplier_solution || '—'}</td>
								<td>${t.supplier_transaction_number || '—'}</td>
								<td>${t.issue_description || ''}</td>
								<td>${receiptHtml}</td>
								<td>${snHtml}</td>
								<td>${evidenceHtml}</td>
								<td>${t.createdAtStr || t.createdAt}</td>
								<td>${t.updatedAtStr || t.updatedAt}</td>
							</tr>
						`;
					});

					const excelTemplate = `
						<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
						<head>
						<!--[if gte mso 9]>
						<xml>
							<x:ExcelWorkbook>
								<x:ExcelWorksheets>
									<x:ExcelWorksheet>
										<x:Name>RMA Reporte</x:Name>
										<x:WorksheetOptions>
											<x:DisplayGridlines/>
										</x:WorksheetOptions>
									</x:ExcelWorksheet>
								</x:ExcelWorksheets>
							</x:ExcelWorkbook>
						</xml>
						<![endif]-->
						<meta charset="utf-8" />
						<style>
							table { border-collapse: collapse; }
							th { background-color: #f2f2f2; border: 1px solid #dddddd; padding: 8px; text-align: left; font-family: sans-serif; font-size: 12px; }
							td { border: 1px solid #dddddd; padding: 6px; font-family: sans-serif; font-size: 11px; vertical-align: middle; }
						</style>
						</head>
						<body>
							<table>
								<!-- Resumen de Métricas -->
								<thead>
									<tr>
										<th colspan="6" style="background-color: #212529; color: #ffffff; font-size: 13px; font-weight: bold; text-align: center; padding: 8px;">CX ERGONOMIC - METRICAS Y RESUMEN DE GARANTIAS</th>
									</tr>
								</thead>
								<tbody>
									<tr>
										<td colspan="3" style="font-weight: bold; background-color: #f8f9fa;">Métrica</td>
										<td colspan="3" style="font-weight: bold; background-color: #f8f9fa;">Valor</td>
									</tr>
									<tr>
										<td colspan="3">Total de casos en reporte:</td>
										<td colspan="3"><b>${tickets.length}</b></td>
									</tr>
									<tr>
										<td colspan="3">Casos Activos:</td>
										<td colspan="3"><b>${tickets.filter((t: any) => !t.archived).length}</b></td>
									</tr>
									<tr>
										<td colspan="3">Casos Archivados:</td>
										<td colspan="3"><b>${tickets.filter((t: any) => t.archived).length}</b></td>
									</tr>
									<tr>
										<td colspan="3">Nuevas solicitudes (recibida):</td>
										<td colspan="3"><b>${tickets.filter((t: any) => t.status === 'recibida').length}</b></td>
									</tr>
									<tr>
										<td colspan="3">En revisión:</td>
										<td colspan="3"><b>${tickets.filter((t: any) => t.status === 'en revision').length}</b></td>
									</tr>
									<tr>
										<td colspan="3">En proceso:</td>
										<td colspan="3"><b>${tickets.filter((t: any) => t.status === 'en proceso').length}</b></td>
									</tr>
									<tr>
										<td colspan="3">Finalizados (RMA exitoso):</td>
										<td colspan="3"><b>${tickets.filter((t: any) => t.status === 'finalizada').length}</b></td>
									</tr>
									<tr>
										<td colspan="3">Rechazados:</td>
										<td colspan="3"><b>${tickets.filter((t: any) => t.status === 'rechazada').length}</b></td>
									</tr>
									<tr style="height: 25px;">
										<td colspan="21" style="border: none; background-color: #ffffff;"></td>
									</tr>
								</tbody>
							</table>

							<table>
								<thead>
									<tr>
										<th>Ticket / Código</th>
										<th>Cliente</th>
										<th>CI / Identificación</th>
										<th>Teléfono</th>
										<th>Ciudad</th>
										<th>Producto</th>
										<th>Marca</th>
										<th>Serial (S/N)</th>
										<th>Estado</th>
										<th>Tipo de Resolución</th>
										<th>Comentario de Resolución</th>
										<th>Solución Cliente</th>
										<th>Transacción Cliente</th>
										<th>Solución Empresa / Proveedor</th>
										<th>Transacción Proveedor</th>
										<th>Descripción del Inconveniente</th>
										<th>Factura / Recibo</th>
										<th>Foto S/N Producto y Caja</th>
										<th>Evidencias</th>
										<th>Fecha de Creación</th>
										<th>Última Actualización</th>
									</tr>
								</thead>
								<tbody>
									${tableRows}
								</tbody>
							</table>
						</body>
						</html>
					`;

					const blob = new Blob([excelTemplate], { type: 'application/vnd.ms-excel;charset=utf-8;' });
					const link = document.createElement('a');
					if (link.download !== undefined) {
						const url = URL.createObjectURL(blob);
						link.setAttribute('href', url);
						link.setAttribute('download', filename);
						link.style.visibility = 'hidden';
						document.body.appendChild(link);
						link.click();
						document.body.removeChild(link);
					}
				}

				// Active tickets PDF export click handler
				document.getElementById('export-pdf-btn')?.addEventListener('click', () => {
					// @ts-ignore
					const activeTickets = (window.ALL_TICKETS || []).filter((t: any) => !t.archived);

					const printWin = window.open('', '_blank');
					if (!printWin) {
						alert('Por favor permite las ventanas emergentes para exportar el reporte en PDF.');
						return;
					}

					const dateStr = new Intl.DateTimeFormat('es-VE', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date());

					const statusMap: Record<string, string> = {
						recibida: 'Nueva solicitud',
						'en revision': 'En revisión',
						'en proceso': 'En proceso',
						finalizada: 'Finalizada',
						rechazada: 'Rechazada',
					};

					const rows = activeTickets.map((t: any, idx: number) => `
						<tr>
							<td style="text-align: center; font-weight: bold;">${idx + 1}</td>
							<td><strong style="font-family: monospace;">${t.ticket_number}</strong></td>
							<td>${t.customer_details?.name || '—'}</td>
							<td>${t.customer_details?.ci || '—'}</td>
							<td>${t.customer_details?.phone || '—'}</td>
							<td>${t.customer_details?.city || '—'}</td>
							<td>${t.product_name || '—'} ${t.product_brand ? `(${t.product_brand})` : ''}</td>
							<td>${t.product_serial_number || '—'}</td>
							<td><span class="badge">${statusMap[t.status] || t.status}</span></td>
							<td>${t.issue_description || '—'}</td>
						</tr>
					`).join('');

					const html = [
						'<!DOCTYPE html>',
						'<html lang="es"><head><meta charset="utf-8">',
						'<title>Reporte PDF RMA - Tickets Activos</title>',
						'<style>',
						'@page { size: A4 landscape; margin: 10mm; }',
						'body { font-family: Arial, Helvetica, sans-serif; padding: 15px; color: #000; font-size: 11px; line-height: 1.3; }',
						'.header { text-align: center; border-bottom: 2px solid #000; padding-bottom: 8px; margin-bottom: 15px; }',
						'.header h1 { font-size: 16px; font-weight: bold; text-transform: uppercase; margin: 0 0 4px 0; }',
						'.header p { margin: 0; font-size: 11px; color: #444; }',
						'table { width: 100%; border-collapse: collapse; margin-top: 10px; }',
						'th, td { border: 1px solid #000; padding: 6px; text-align: left; vertical-align: top; }',
						'th { background-color: #f0f0f0; font-weight: bold; font-size: 10px; text-transform: uppercase; }',
						'.badge { font-weight: bold; text-transform: uppercase; font-size: 9px; }',
						'</style></head><body>',
						'<div class="header">',
						'<h1>CX ERGONOMIC - REPORTE DE TICKETS ACTIVOS EN SISTEMA</h1>',
						'<p>Fecha de emisión: ' + dateStr + ' &nbsp;|&nbsp; Total casos abiertos: ' + activeTickets.length + '</p>',
						'</div>',
						'<table>',
						'<thead><tr>',
						'<th>#</th><th>Ticket</th><th>Cliente</th><th>CI/ID</th><th>Teléfono</th><th>Ciudad</th><th>Producto</th><th>Serial (S/N)</th><th>Estado</th><th>Descripción de Falla</th>',
						'</tr></thead>',
						'<tbody>' + rows + '</tbody>',
						'</table>',
						'<script>window.onload = function() { window.print(); };</' + 'script>',
						'</body></html>'
					].join('\n');

					printWin.document.write(html);
					printWin.document.close();
				});

				// Active tickets Excel export click handler
				document.getElementById('export-active-btn')?.addEventListener('click', () => {
					// @ts-ignore
					const activeTickets = (window.ALL_TICKETS || []).filter(t => !t.archived);
					exportToExcelHTML('RMA_Solicitudes_Activas.xls', activeTickets);
				});

				// Archived tickets Excel export click handler
				document.getElementById('export-archived-btn')?.addEventListener('click', () => {
					const visibleTicketNumbers = filteredArchivedRows.map(row => row.getAttribute('data-ticket-number'));
					// @ts-ignore
					const archivedTicketsFiltered = (window.ALL_TICKETS || []).filter(t => t.archived && visibleTicketNumbers.includes(t.ticket_number));
					exportToExcelHTML('RMA_Archivados_Filtrados.xls', archivedTicketsFiltered);
				});

				// Advanced Excel report click handler
				document.getElementById('generate-adv-report-btn')?.addEventListener('click', () => {
					const scope = (document.getElementById('report-scope') as HTMLSelectElement)?.value || 'all';
					const status = (document.getElementById('report-status') as HTMLSelectElement)?.value || 'all';
					const startDateVal = (document.getElementById('report-start-date') as HTMLInputElement)?.value;
					const endDateVal = (document.getElementById('report-end-date') as HTMLInputElement)?.value;

					// @ts-ignore
					let tickets = window.ALL_TICKETS || [];

					if (scope === 'active') {
						tickets = tickets.filter((t: any) => !t.archived);
					} else if (scope === 'archived') {
						tickets = tickets.filter((t: any) => t.archived);
					}

					if (status !== 'all') {
						tickets = tickets.filter((t: any) => t.status === status);
					}

					if (startDateVal) {
						const startLimit = new Date(startDateVal + "T00:00:00").getTime();
						tickets = tickets.filter((t: any) => new Date(t.createdAt).getTime() >= startLimit);
					}
					if (endDateVal) {
						const endLimit = new Date(endDateVal + "T23:59:59").getTime();
						tickets = tickets.filter((t: any) => new Date(t.createdAt).getTime() <= endLimit);
					}

					let filename = 'Reporte_RMA';
					if (scope !== 'all') filename += `_${scope.toUpperCase()}`;
					if (status !== 'all') filename += `_${status.replace(' ', '_').toUpperCase()}`;
					if (startDateVal || endDateVal) filename += '_Filtrado';
					filename += '.xls';

					exportToExcelHTML(filename, tickets);

					const modalEl = document.getElementById('advancedReportModal');
					if (modalEl) {
						// @ts-ignore
						const modal = bootstrap.Modal.getInstance(modalEl);
						modal?.hide();
					}
				});

				// Initial execution
				updateArchivedPagination();

				// Abrir automáticamente un ticket si llega ?ticket=RMA-... (ej. desde Clientes)
				const requestedTicket = new URLSearchParams(window.location.search).get('ticket');
				if (requestedTicket) {
					// @ts-ignore
					const t = window.ALL_TICKETS.find((x: any) => x.ticket_number === requestedTicket);
					if (t) openTicketDetailsModal(t);
				}

				// Live search on active tickets (Kanban board only)
				const globalSearchInput = document.getElementById('global-search-input');
				globalSearchInput?.addEventListener('input', (e) => {
					const query = (e.target as HTMLInputElement).value.toLowerCase().trim();
					
					// Filter cards
					const cards = document.querySelectorAll('.draggable-ticket');
					cards.forEach(card => {
						const ticketNum = card.getAttribute('data-ticket-number')?.toLowerCase() || '';
						const clientName = card.querySelector('h4')?.textContent?.toLowerCase() || '';
						if (ticketNum.includes(query) || clientName.includes(query)) {
							(card as HTMLElement).style.setProperty('display', '', 'important');
						} else {
							(card as HTMLElement).style.setProperty('display', 'none', 'important');
						}
					});
				});
			});
		</script>

		<!-- Main JS -->
		<script src="/js/main.js" type="module" is:inline></script>
	</body>
</html>
