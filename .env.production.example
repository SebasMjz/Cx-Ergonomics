# Entorno de Producción para Dokploy / VPS
NODE_ENV=production
PORT=4321

# Conexión a MongoDB (Usa el nombre del contenedor de Mongo en Dokploy o en Compose)
# Si usas Docker Compose: mongodb://mongo:27017/cx-ergonomics
# Si usas Base de Datos de Dokploy: usa la URL interna que te da Dokploy
MONGODB_URI=mongodb://mongo:27017/cx-ergonomics
MONGODB_DB=cx-ergonomics

# Rutas persistentes para uploads (RMA y Catálogo unificados en /app/uploads)
UPLOADS_DIR=/app/uploads
# CATALOG_UPLOADS_DIR=/app/uploads/catalogo (opcional, por defecto se guarda dentro de UPLOADS_DIR/catalogo)

# URL pública (el dominio o IP asignada en Dokploy)
PUBLIC_SITE_URL=https://tu-dominio.com

# Autenticación y Seguridad (¡Cambia esto por una cadena aleatoria y segura!)
JWT_SECRET=reemplaza-esta-clave-secreta-en-produccion-con-un-string-largo
JWT_EXPIRES_IN=7d

# Credenciales del Administrador Inicial (se creará automáticamente en el primer inicio si no existe)
ADMIN_INITIAL_EMAIL=admin@cxergonomic.com
ADMIN_INITIAL_PASSWORD=Admin123*
