---
// Sidebar compartido del panel administrativo (RMA + Catálogo & Sitio).
// Se reutiliza en /rma y en todas las páginas de gestión.
interface Props {
	active?: string;
	session: { name: string; role: 'admin' | 'technical'; must_change_password?: boolean };
}

const { active = '', session } = Astro.props;

const operativo = [
	{ key: 'dashboard', href: '/rma', icon: 'ri-dashboard-line', label: 'Dashboard RMA' },
	{ key: 'clientes', href: '/rma/clientes', icon: 'ri-contacts-book-line', label: 'Historial Clientes' },
	{ key: 'tiendas', href: '/rma/tiendas', icon: 'ri-store-2-line', label: 'Tiendas y Socios' },
	{ key: 'distribuidores', href: '/rma/distribuidores', icon: 'ri-user-shared-line', label: 'Prospectos Distribuidor' },
	{ key: 'usuarios', href: '/rma/usuarios', icon: 'ri-user-settings-line', label: 'Gestión de Usuarios', adminOnly: true },
	{ key: 'new', href: '/rma/new?from=dashboard', icon: 'ri-file-add-line', label: 'Registrar Solicitud' },
];

const catalogo = [
	{ key: 'productos', href: '/rma/productos', icon: 'ri-archive-stack-line', label: 'Productos' },
	{ key: 'categorias', href: '/rma/categorias', icon: 'ri-folders-line', label: 'Categorías' },
	{ key: 'etiquetas', href: '/rma/etiquetas', icon: 'ri-price-tag-3-line', label: 'Etiquetas' },
	{ key: 'pos', href: '/rma/puntos-de-venta', icon: 'ri-map-pin-2-line', label: 'Puntos de Venta' },
	{ key: 'faq', href: '/rma/faq', icon: 'ri-question-answer-line', label: 'Preguntas Frecuentes' },
	{ key: 'wallpapers', href: '/rma/wallpapers', icon: 'ri-image-2-line', label: 'Wallpapers' },
	{ key: 'ajustes', href: '/rma/ajustes', icon: 'ri-settings-3-line', label: 'Ajustes del Sitio' },
];
---

<!-- Overlay for mobile sidebar -->
<div class="sidebar-overlay"></div>

<!-- Sidebar -->
<aside class="sidebar">
	<div class="sidebar-header">
		<a href="/rma" class="sidebar-brand text-decoration-none d-flex align-items-center justify-content-center">
			<img
				src="/img/logos/logo cx.png"
				alt="Logo CX"
				class="brand-image normal-logo"
				style="max-height: 32px;"
			/>
			<span class="brand-name mb-0 opacity-80 ms-2 text-body fw-bold">CX Ergonomic</span>
		</a>
	</div>

	<div class="sidebar-content" data-simplebar>
		<nav class="nav-tree">
			<ul class="list-unstyled">
				<li class="nav-section">
					<span class="nav-section-text text-uppercase px-2">Panel Operativo</span>
				</li>
				{operativo.map((item) => (
					(!item.adminOnly || session.role === 'admin') && (
						<li class={`nav-item ${active === item.key ? 'active' : ''}`}>
							<a class="nav-link" href={item.href}>
								<i class={item.icon}></i>
								<span>{item.label}</span>
							</a>
						</li>
					)
				))}

				<li class="nav-section">
					<span class="nav-section-text text-uppercase px-2">Catálogo &amp; Sitio</span>
				</li>
				{catalogo.map((item) => (
					<li class={`nav-item ${active === item.key ? 'active' : ''}`}>
						<a class="nav-link" href={item.href}>
							<i class={item.icon}></i>
							<span>{item.label}</span>
						</a>
					</li>
				))}

				<li class="nav-section">
					<span class="nav-section-text text-uppercase px-2">Tienda</span>
				</li>
				<li class={`nav-item ${active === 'catalogo' ? 'active' : ''}`}>
					<a class="nav-link" href="/">
						<i class="ri-store-2-line"></i>
						<span>Catálogo público</span>
					</a>
				</li>
			</ul>
		</nav>
	</div>

	<div class="sidebar-footer p-3 border-top bg-body-tertiary">
		<div class="d-flex align-items-center justify-content-between gap-2 mb-2.5 p-2 rounded-3 bg-body border shadow-sm">
			<div class="d-flex align-items-center gap-2 overflow-hidden">
				<div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center flex-shrink-0" style="width: 34px; height: 34px;">
					<i class="ri-user-3-line fs-6"></i>
				</div>
				<div class="text-truncate">
					<small class="text-muted d-block" style="font-size: 0.65rem; text-transform: uppercase;">Usuario</small>
					<strong class="text-body d-block text-truncate" style="font-size: 0.82rem;" id="active-user-name">{session.name}</strong>
					<span class="badge bg-secondary-subtle text-secondary py-0.5 px-1.5" style="font-size: 0.62rem;">
						{session.role === 'admin' ? 'Administrador' : 'Técnico'}
					</span>
				</div>
			</div>

			<div class="dropup">
				<button
					class={`btn btn-sm p-1 rounded-circle border-0 text-secondary ${session.must_change_password ? 'text-warning fw-bold' : ''}`}
					type="button"
					data-bs-toggle="dropdown"
					aria-expanded="false"
					title="Opciones de perfil"
				>
					<i class={session.must_change_password ? 'ri-alert-line text-warning fs-5' : 'ri-more-2-fill fs-5'}></i>
				</button>
				<ul class="dropdown-menu dropdown-menu-end shadow-sm rounded-3 border-0 py-1" style="font-size: 0.82rem;">
					<li>
						<button
							type="button"
							class="dropdown-item d-flex align-items-center gap-2 py-2 px-3"
							id="sidebar-change-pass-btn"
							data-must-change={session.must_change_password ? 'true' : 'false'}
						>
							<i class="ri-key-2-line text-warning"></i>
							<span>{session.must_change_password ? '⚠️ Cambiar Contraseña (Obligatorio)' : 'Cambiar Contraseña'}</span>
						</button>
					</li>
				</ul>
			</div>
		</div>

		<button type="button" class="btn btn-sm btn-outline-danger w-100 py-1.5 rounded-pill d-flex align-items-center justify-content-center gap-1.5" id="logout-button">
			<i class="ri-logout-box-line"></i>
			<span>Cerrar sesión</span>
		</button>
	</div>
</aside>

<!-- Modal Cambiar Contraseña -->
<div class="modal fade" id="sidebarChangePassModal" tabindex="-1" aria-labelledby="sidebarChangePassModalLabel" aria-hidden="true" data-bs-backdrop={session.must_change_password ? 'static' : 'true'} data-bs-keyboard={session.must_change_password ? 'false' : 'true'}>
	<div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
		<div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
			<form id="sidebar-change-pass-form">
				<div class="modal-header bg-dark text-white py-3 border-0">
					<h5 class="modal-title fw-bold fs-6" id="sidebarChangePassModalLabel">
						<i class="ri-key-2-line me-2 text-warning"></i>
						{session.must_change_password ? 'Cambio Obligatorio de Contraseña' : 'Cambiar Contraseña'}
					</h5>
					{!session.must_change_password && (
						<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
					)}
				</div>
				<div class="modal-body p-4 bg-body-tertiary">
					{session.must_change_password && (
						<div class="alert alert-warning py-2.5 px-3 small border-0 shadow-sm rounded-3 mb-3.5 d-flex align-items-center gap-2">
							<i class="ri-alert-line fs-5 flex-shrink-0 text-warning"></i>
							<span style="font-size: 0.82rem; line-height: 1.35;">Es tu primer ingreso al sistema. Por tu seguridad, debes cambiar tu contraseña inicial antes de continuar.</span>
						</div>
					)}
					<div class="mb-3">
						<label for="sidebar-new-pass" class="form-label small fw-bold text-muted mb-1">Nueva Contraseña</label>
						<input type="password" class="form-control rounded-3 shadow-none" id="sidebar-new-pass" required minlength="6" placeholder="Mínimo 6 caracteres" />
					</div>
					<div class="mb-3">
						<label for="sidebar-confirm-pass" class="form-label small fw-bold text-muted mb-1">Confirmar Nueva Contraseña</label>
						<input type="password" class="form-control rounded-3 shadow-none" id="sidebar-confirm-pass" required minlength="6" placeholder="Repite la contraseña" />
					</div>
					<div id="sidebar-pass-error" class="alert alert-danger d-none py-2 px-3 small rounded-3 mb-0"></div>
				</div>
				<div class="modal-footer bg-white border-top p-3 d-flex justify-content-between">
					{!session.must_change_password && (
						<button type="button" class="btn btn-sm btn-light border rounded-pill px-3.5 fw-semibold text-muted" data-bs-dismiss="modal">
							Cancelar
						</button>
					)}
					<button type="submit" class="btn btn-sm btn-dark rounded-pill px-4 fw-bold ms-auto" id="sidebar-pass-submit-btn">
						<i class="ri-check-line me-1 text-success"></i> Actualizar Contraseña
					</button>
				</div>
			</form>
		</div>
	</div>
</div>

<script>
	// Cierre de sesión y cambio de contraseña
	document.addEventListener('DOMContentLoaded', () => {
		document.getElementById('logout-button')?.addEventListener('click', async () => {
			await fetch('/api/auth/logout', { method: 'POST' });
			window.location.href = '/login';
		});

		const btn = document.getElementById('sidebar-change-pass-btn');
		const modalEl = document.getElementById('sidebarChangePassModal');
		const isMustChange = btn?.getAttribute('data-must-change') === 'true';

		if (modalEl) {
			// @ts-ignore
			const modal = bootstrap.Modal.getOrCreateInstance(modalEl);

			// Si es el primer ingreso obligar apertura inmediata
			if (isMustChange) {
				modal.show();
			}

			btn?.addEventListener('click', () => {
				modal.show();
			});

			document.getElementById('sidebar-change-pass-form')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const errEl = document.getElementById('sidebar-pass-error');
				const newPass = (document.getElementById('sidebar-new-pass') as HTMLInputElement).value;
				const confirmPass = (document.getElementById('sidebar-confirm-pass') as HTMLInputElement).value;
				const submitBtn = document.getElementById('sidebar-pass-submit-btn') as HTMLButtonElement;

				if (errEl) errEl.classList.add('d-none');

				if (newPass !== confirmPass) {
					if (errEl) {
						errEl.textContent = 'Las contraseñas no coinciden.';
						errEl.classList.remove('d-none');
					}
					return;
				}

				try {
					submitBtn.disabled = true;
					submitBtn.textContent = 'Guardando...';

					const res = await fetch('/api/users/change-password', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify({ newPassword: newPass }),
					});
					const data = await res.json();
					if (!res.ok) throw new Error(data.error || 'Error al actualizar contraseña');

					window.location.reload();
				} catch (err: any) {
					submitBtn.disabled = false;
					submitBtn.innerHTML = '<i class="ri-check-line me-1 text-success"></i> Actualizar Contraseña';
					if (errEl) {
						errEl.textContent = err.message;
						errEl.classList.remove('d-none');
					}
				}
			});
		}
	});
</script>
