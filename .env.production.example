# Entorno de Producción para Dokploy / VPS
NODE_ENV=production
PORT=4321
MONGODB_URI=mongodb://mongo:27017/cx-ergonomics
UPLOADS_DIR=/app/uploads
PUBLIC_SITE_URL=http://tu-ip-o-dominio:4321

# Autenticación y Seguridad
