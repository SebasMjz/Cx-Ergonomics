---
import { connectMongoose } from '../../lib/mongo';
import { readCookieValue, verifyAuthToken } from '../../lib/auth/jwt';
import { TicketModel, type TicketStatus } from '../../lib/models/Ticket';
import { UserModel } from '../../lib/models/User';
import { getSiteSettings } from '../../lib/models/SiteSettings';
import AdminSidebar from '../../components/AdminSidebar.astro';

const authToken = readCookieValue(Astro.request.headers.get('cookie'), 'cx_auth');
const session = authToken ? verifyAuthToken(authToken) : null;

if (!session) {
	return Astro.redirect('/login');
}

await connectMongoose();

// DB Migration: Ensure all tickets have the archived property set as boolean
// to prevent old tickets from showing in wrong places. We set it to false for any non-archived tickets.
await TicketModel.updateMany({ archived: { $ne: true } }, { $set: { archived: false } });

type DashboardTicket = {
	_id: any;
	ticket_number: string;
	status: TicketStatus;
	issue_description: string;
	product_serial_number: string;
	sales_receipt_image: string;
	product_sn_image?: string;
	evidence_video: string;
	product_name?: string;
	product_brand?: string;
	store_manager_name?: string;
	store_manager_phone?: string;
	step_left_at_branch?: boolean;
	step_sent_to_distributor?: boolean;
	step_resolved?: boolean;
	customer_details: {
		name: string;
		phone: string;
		ci: string;
		city?: string;
		department?: string;
	};
	resolution_type?: 'rechazo' | 'descuento' | 'reponer';
	resolution_main_comment?: string;
	client_solution?: string;
	supplier_solution?: string;
	history: Array<{
		status: TicketStatus;
		note?: string;
		updated_by_user_id?: string;
		updated_at: Date;
		visibility?: string;
		from_client?: boolean;
		attachments?: string[];
	}>;
	archived?: boolean;
	updatedAt: Date;
	createdAt: Date;
};

// Fetch only active tickets for the board (where archived is not true)
const activeTickets = (await TicketModel.find({ archived: { $ne: true } })
	.sort({ order: 1, updatedAt: -1 })
	.lean()) as DashboardTicket[];

// Fetch archived tickets separately
const archivedTickets = (await TicketModel.find({ archived: true })
	.sort({ updatedAt: -1 })
	.lean()) as DashboardTicket[];

const allTickets = [...activeTickets, ...archivedTickets];

const users = await UserModel.find().lean();
const userMap = users.reduce((acc, u) => {
	acc[u._id.toString()] = u.name;
	return acc;
}, {} as Record<string, string>);

// Settings: enlace de seguimiento y plantillas de WhatsApp por columna
const settings = await getSiteSettings();
// La vista pública de seguimiento es parte del proyecto (/seguimiento).
// Si el admin no configura un dominio propio, usamos el origen actual automáticamente.
const trackingBase = (settings.rma_tracking_url || '').trim() || `${Astro.url.origin}/seguimiento`;
// Construye el enlace de seguimiento de un ticket concreto (deep-link).
function trackingUrlFor(ticketNumber: string) {
	const sep = trackingBase.includes('?') ? '&' : '?';
	return `${trackingBase}${sep}ticket=${encodeURIComponent(ticketNumber)}`;
}
const waTemplates: Record<TicketStatus, string> = {
	recibida: settings.rma_wa_msg_recibida || '',
	'en proceso': settings.rma_wa_msg_proceso || '',
	'en revision': settings.rma_wa_msg_proceso || '', // default to in process message
	finalizada: settings.rma_wa_msg_finalizada || '',
	rechazada: settings.rma_wa_msg_rechazo || '',
};
const waRechazoTemplate = settings.rma_wa_msg_rechazo || '';

// Normaliza el teléfono a formato internacional para wa.me.
// Si trae 8 dígitos (sin código de país) se antepone 591 (Bolivia).
function normalizePhone(raw: string) {
	let digits = (raw || '').replace(/\D/g, '');
	if (digits.length === 8) digits = '591' + digits;
	return digits;
}

function buildWaHref(ticket: DashboardTicket, status: TicketStatus) {
	const tmpl = waTemplates[status] || '';
	const msg = tmpl
		.replace(/\{ticket\}/g, ticket.ticket_number)
		.replace(/\{cliente\}/g, ticket.customer_details.name)
		.replace(/\{url\}/g, trackingUrlFor(ticket.ticket_number));
	const finalMsg = status === 'rechazada'
		? msg.replace(/\{motivo\}/g, ticket.resolution_main_comment || '')
		: msg;
	const phone = normalizePhone(ticket.store_manager_phone || ticket.customer_details.phone);
	return `https://wa.me/${phone}?text=${encodeURIComponent(finalMsg)}`;
}

const phaseLabels: Record<TicketStatus, string> = {
	recibida: 'Nuevas solicitudes',
	'en proceso': 'En proceso',
	'en revision': 'En revisión',
	finalizada: 'Finalizadas',
	rechazada: 'Rechazadas',
};

// Colores semáforo expandidos: Nuevas = azul, En proceso = ámbar, En revisión = púrpura, Finalizadas = verde, Rechazadas = rojo.
const phaseTone: Record<TicketStatus, string> = {
	recibida: 'blue',
	'en proceso': 'amber',
	'en revision': 'purple',
	finalizada: 'green',
	rechazada: 'red',
};

const ticketsByStatus = activeTickets.reduce(
	(acc, ticket) => {
		if (acc[ticket.status]) {
			acc[ticket.status].push(ticket);
		}
		return acc;
	},
	{
		recibida: [] as DashboardTicket[],
		'en proceso': [] as DashboardTicket[],
		'en revision': [] as DashboardTicket[],
		finalizada: [] as DashboardTicket[],
		rechazada: [] as DashboardTicket[],
	}
);

// Group all tickets (active + archived) to compute global counts
const allTicketsByStatus = allTickets.reduce(
	(acc, ticket) => {
		if (acc[ticket.status]) {
			acc[ticket.status].push(ticket);
		}
		return acc;
	},
	{
		recibida: [] as DashboardTicket[],
		'en proceso': [] as DashboardTicket[],
		'en revision': [] as DashboardTicket[],
		finalizada: [] as DashboardTicket[],
		rechazada: [] as DashboardTicket[],
	}
);

const totalTickets = allTickets.length;
const reviewTickets = allTicketsByStatus.recibida.length;
const inProgressTickets = allTicketsByStatus['en proceso'].length;
const inRevisionTickets = allTicketsByStatus['en revision'] ? allTicketsByStatus['en revision'].length : 0;
const doneTickets = allTicketsByStatus.finalizada.length;
const rejectedTickets = allTicketsByStatus.rechazada ? allTicketsByStatus.rechazada.length : 0;
const openTickets = reviewTickets + inProgressTickets + inRevisionTickets;


const kanbanColumns = (['recibida', 'en revision', 'en proceso', 'finalizada', 'rechazada'] as TicketStatus[]).map((status) => ({
	status,
	label: phaseLabels[status],
	tone: phaseTone[status],
	count: ticketsByStatus[status] ? ticketsByStatus[status].length : 0,
	items: ticketsByStatus[status] || [],
}));

const now = new Date();

function formatDate(date: Date) {
	return new Intl.DateTimeFormat('es-VE', {
		day: '2-digit',
		month: 'short',
		year: 'numeric',
	}).format(date);
}

function timeAgo(date: Date) {
	const minutes = Math.floor((now.getTime() - date.getTime()) / 60000);
	if (minutes < 60) return `Hace ${Math.max(minutes, 1)} min`;
	const hours = Math.floor(minutes / 60);
	if (hours < 24) return `Hace ${hours} h`;
	const days = Math.floor(hours / 24);
	return `Hace ${days} d`;
}

const monthLabel = now.toLocaleDateString('es-VE', { month: 'long', year: 'numeric' });

const ticketsJson = JSON.stringify(allTickets.map(t => ({
	...t,
	createdAtStr: formatDate(new Date(t.createdAt)),
	updatedAtStr: formatDate(new Date(t.updatedAt)),
	history: t.history.map(h => ({
		...h,
		userName: h.updated_by_user_id ? (userMap[h.updated_by_user_id] || 'Cliente / Sistema') : 'Cliente / Sistema'
	}))
})));
---

<html lang="es" data-bs-theme="light" data-theme-fixed="light">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1.0, viewport-fit=cover" />
		<title>Dashboard RMA | CX Ergonomic</title>
		<meta
			name="description"
			content="Panel de RMA para seguimiento de tickets, garantías y evidencias."
		/>
		
		<!-- Astero Admin CSS -->
		<link href="/css/style.css" rel="stylesheet" />
		<link href="/css/skin.css" rel="stylesheet" />

		<!-- Remix Icons -->
		<link href="https://cdn.jsdelivr.net/npm/remixicon@4.6.0/fonts/remixicon.css" rel="stylesheet" />

		<!-- Fonts: Source Sans 3, Ubuntu Mono, and Outfit -->
		<link
			href="https://fonts.googleapis.com/css2?family=Source+Sans+3:ital,wght@0,200..900;1,200..900&family=Ubuntu+Mono:ital,wght@0,400;0,700;1,400;1,700&family=Outfit:wght@900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="wrapper">
			<AdminSidebar active="dashboard" session={session} />

			<!-- Main Content Area -->
			<main class="main-content px-2">
				
				<!-- Black Header / Navigation -->
				<header class="navbar navbar-expand-lg border-bottom px-3 py-2 bg-dark navbar-dark shadow-sm">
					<div class="container-fluid">
						<!-- Toggle button for sidebar -->
						<button class="btn btn-icon border-0 me-2 text-white" id="sidebar-toggle" type="button" aria-label="Toggle navigation">
							<i class="ri-menu-2-line fs-4"></i>
						</button>
						
						<!-- Breadcrumb / Status -->
						<span class="navbar-text small text-white-50 d-none d-sm-inline-block">
							<i class="ri-settings-4-line me-1"></i> RMA & Garantías • {monthLabel}
						</span>

						<!-- Search box -->
						<form class="d-none d-md-flex align-items-center ms-3" style="max-width: 280px;" onsubmit="event.preventDefault();">
							<div class="input-group input-group-sm border border-secondary rounded-pill overflow-hidden bg-body bg-opacity-10">
								<span class="input-group-text border-0 bg-transparent text-white-50"><i class="ri-search-line"></i></span>
								<input type="text" id="global-search-input" class="form-control border-0 shadow-none ps-0 text-white bg-transparent" placeholder="Buscar ticket activo..." aria-label="Buscar ticket" />
							</div>
						</form>
					</div>
				</header>

				<!-- Content Wrapper -->
				<div class="content-wrapper py-5">
					<div class="container-fluid">
						
						<!-- Welcome & Actions Header -->
						<div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-5">
							<div>
								
								<h1 class="h3 mb-0 fw-bold text-dark">RMA Dashboard</h1>
								<p class="text-muted small mb-0">Seguimiento de garantías, evidencias y resolución de casos.</p>
							</div>
							<div class="d-flex gap-2 flex-wrap">
								<button type="button" class="btn btn-sm btn-outline-danger px-3 rounded-pill fw-semibold" id="export-pdf-btn">
									<i class="ri-file-pdf-line me-1"></i> Exportar PDF
								</button>
								<button type="button" class="btn btn-sm btn-outline-success px-3 rounded-pill fw-semibold" data-bs-toggle="modal" data-bs-target="#advancedReportModal">
									<i class="ri-file-excel-2-line me-1"></i> Reporte Avanzado
								</button>
								<button type="button" class="btn btn-sm btn-outline-dark px-3 rounded-pill fw-semibold" id="export-active-btn">
									<i class="ri-file-excel-line me-1"></i> Exportar Activos
								</button>
								<a href="/rma/new?from=dashboard" class="btn btn-sm btn-dark px-3 rounded-pill fw-semibold">
									<i class="ri-add-line me-1"></i> Nuevo ticket
								</a>
							</div>
						</div>

						<!-- Statistics cards (Small Boxes - Grayscale style, Flat borders, no neon) -->
						<div class="row g-4 mb-5">
							<!-- Casos Totales -->
							<div class="col-xl-2 col-md-4 col-sm-6">
								<div class="small-box bg-dark text-white border-0 shadow-sm">
									<div class="inner text-white">
										<h3 class="text-white">{totalTickets}</h3>
										<p class="text-white-50">Casos Totales</p>
									</div>
									<div class="small-box-icon text-white-50">
										<i class="ri-history-line"></i>
									</div>
								</div>
							</div>
							<!-- Nuevas Solicitudes -->
							<div class="col-xl-2 col-md-4 col-sm-6">
								<div class="small-box bg-body border border-light-subtle text-dark shadow-sm">
									<div class="inner">
										<h3>{reviewTickets}</h3>
										<p class="text-muted">Nuevas Solicitudes</p>
									</div>
									<div class="small-box-icon text-muted animate-icon" style="opacity: 0.2;">
										<i class="ri-mail-unread-line"></i>
									</div>
								</div>
							</div>
							<!-- En Revisión -->
							<div class="col-xl-2 col-md-4 col-sm-6">
								<div class="small-box bg-body border border-light-subtle text-dark shadow-sm">
									<div class="inner">
										<h3>{inRevisionTickets}</h3>
										<p class="text-muted">En Revisión</p>
									</div>
									<div class="small-box-icon text-muted animate-icon" style="opacity: 0.2;">
										<i class="ri-file-search-line"></i>
									</div>
								</div>
							</div>
							<!-- En Proceso -->
							<div class="col-xl-2 col-md-4 col-sm-6">
								<div class="small-box bg-body border border-light-subtle text-dark shadow-sm">
									<div class="inner">
										<h3>{inProgressTickets}</h3>
										<p class="text-muted">En Proceso</p>
									</div>
									<div class="small-box-icon text-muted animate-icon" style="opacity: 0.2;">
										<i class="ri-loader-4-line"></i>
									</div>
								</div>
							</div>
							<!-- Finalizadas -->
							<div class="col-xl-2 col-md-4 col-sm-6">
								<div class="small-box bg-body border border-light-subtle text-dark shadow-sm">
									<div class="inner">
										<h3>{doneTickets}</h3>
										<p class="text-muted">Finalizadas</p>
									</div>
									<div class="small-box-icon text-muted animate-icon" style="opacity: 0.2;">
										<i class="ri-checkbox-circle-line"></i>
									</div>
								</div>
							</div>
							<!-- Rechazadas -->
							<div class="col-xl-2 col-md-4 col-sm-6">
								<div class="small-box bg-body border border-light-subtle text-dark shadow-sm">
									<div class="inner">
										<h3>{rejectedTickets}</h3>
										<p class="text-muted">Rechazadas</p>
									</div>
									<div class="small-box-icon text-muted animate-icon" style="opacity: 0.2;">
										<i class="ri-close-circle-line"></i>
									</div>
								</div>
							</div>
						</div>

						<!-- Main Kanban Layout Grid -->
						<div class="row g-4 mb-5">
							<!-- Kanban Board (Full Width) -->
							<div class="col-12">
								<div class="card border border-light-subtle h-100 shadow-sm">
									<div class="card-header bg-transparent py-4 border-bottom-0">
										<div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
											<div>
												<h2 class="h5 mb-1 fw-bold text-dark">Solicitudes</h2>
												<p class="text-muted small mb-0">Mueve los tickets entre columnas o haz clic para ver y añadir notas de soporte.</p>
											</div>
											<span class="badge bg-secondary-subtle text-secondary rounded-pill">{totalTickets} registros</span>
										</div>
									</div>
									<div class="card-body p-4 pt-0">
										<div class="d-flex flex-nowrap overflow-x-auto gap-3 pb-3 kanban-board-container" style="min-width: 100%;">
											{kanbanColumns.map((column) => (
												<div class="flex-shrink-0 kanban-column-wrapper" style="width: 290px; min-width: 290px;">
													<!-- Color indicators: top border matches column state -->
													<div class={`card h-100 bg-body-tertiary border-0 shadow-none rounded-3 column-${column.tone}`} style="overflow: hidden;">
														<!-- Column Header -->
														<div class="card-header py-3 bg-transparent border-0 d-flex justify-content-between align-items-center">
															<h3 class="card-title h6 mb-0 fw-bold text-dark">{column.label}</h3>
															<span class="badge bg-body-secondary text-body rounded-pill px-2.5 py-1">{column.count}</span>
														</div>
														
														<!-- Drop Zone Area -->
														<div class="card-body p-2.5 d-flex flex-column lane-column" data-status={column.status} style="transition: background-color 0.2s ease;">
															{column.items.length === 0 ? (
																<div class="empty-state text-muted text-center py-5 my-auto w-100">
																	<i class="ri-inbox-line fs-2 mb-2 d-block opacity-50"></i>
																	<span class="small d-block">Sin tickets en esta fase</span>
																</div>
															) : (
																column.items.map((ticket) => (
																	<div 
																		class="card mb-2.5 draggable-ticket shadow-sm" 
																		draggable="true" 
																		data-ticket-number={ticket.ticket_number}
																		data-status-type={column.status}
																		style="cursor: grab;"
																	>
																		<div class="card-body p-3.5">
																			<!-- Badge and Time -->
																			<div class="d-flex justify-content-between align-items-center mb-3">
																				<span class="badge bg-secondary-subtle text-secondary rounded-pill fw-bold d-inline-flex align-items-center gap-1" style="font-size: 0.7rem; letter-spacing: 0.02em;">
																					{ticket.ticket_number}
																					{ticket.history?.some((h: any) => h.from_client) && (
																						<span class="rounded-circle bg-danger" style="width: 7px; height: 7px; display: inline-block;" title="Mensaje recibido del cliente"></span>
																					)}
																				</span>
																				<span class="text-muted small time-ago-label" data-timestamp={ticket.createdAt.toISOString()} style="font-size: 0.72rem;">
																					<i class="ri-time-line me-1"></i>{timeAgo(new Date(ticket.createdAt))}
																				</span>
																			</div>
																			
																			<!-- Customer name -->
																			<h4 class="h6 text-body fw-bold mb-2.5" style="font-size: 0.92rem;">{ticket.customer_details.name}</h4>
																			
																			<!-- Issue description -->
																			<p class="text-muted small mb-3" style="line-height: 1.5; font-size: 0.85rem; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; min-height: 2.55rem;">
																				{ticket.issue_description}
																			</p>
																			
																			<!-- Metadata stacked cleanly with subtle icons -->
																			<div class="mt-3.5" style="font-size: 0.72rem;">
																				<div class="d-flex align-items-center text-muted mb-1.5">
																					<i class="ri-barcode-line me-1.5 text-secondary" style="font-size: 0.85rem;"></i>
																					<span class="text-truncate" style="max-width: 100%;">S/N: {ticket.product_serial_number}</span>
																				</div>
																				<div class="d-flex align-items-center text-muted mb-3">
																					<i class="ri-calendar-event-line me-1.5 text-secondary" style="font-size: 0.85rem;"></i>
																					<span>Creado: {formatDate(new Date(ticket.createdAt))}</span>
																				</div>
																				
																				<!-- WhatsApp: mensaje pre-armado según la columna -->
																				<a
																					href={buildWaHref(ticket, column.status)}
																					target="_blank"
																					rel="noopener"
																					class="btn btn-xs w-100 py-1.5 rounded-pill d-flex align-items-center justify-content-center gap-1.5 wa-ticket-btn mb-1"
																					style="font-size: 0.72rem; background-color: #25D366; color: #fff; border: none;"
																				>
																					<i class="ri-whatsapp-line"></i> Enviar WhatsApp
																				</a>

																				<button
																					type="button"
																					class="btn btn-xs btn-outline-dark w-100 py-1.5 rounded-pill d-flex align-items-center justify-content-center gap-1.5 print-ticket-btn mb-1"
																					data-ticket-number={ticket.ticket_number}
																					style="font-size: 0.72rem;"
																				>
																					<i class="ri-printer-line"></i> Imprimir Ticket
																				</button>

																				<!-- Column actions -->
																				{column.status === 'recibida' && (
																					<div class="mt-2 d-flex flex-column gap-1">
																						<button type="button" class="btn btn-xs btn-dark w-100 py-1.5 rounded-pill d-flex align-items-center justify-content-center gap-1.5 advance-ticket-btn" data-ticket-number={ticket.ticket_number} data-next-status="en revision" style="font-size: 0.72rem;">
																							Avanzar a En revisión <i class="ri-arrow-right-line"></i>
																						</button>
																						<button type="button" class="btn btn-xs btn-outline-danger w-100 py-1.5 rounded-pill d-flex align-items-center justify-content-center gap-1.5 reject-ticket-btn" data-ticket-number={ticket.ticket_number} style="font-size: 0.72rem;">
																							<i class="ri-close-circle-line"></i> Rechazar Solicitud
																						</button>
																					</div>
																				)}

																				{column.status === 'en revision' && (
																					<div class="mt-2 d-flex flex-column gap-1">
																						<button type="button" class="btn btn-xs btn-dark w-100 py-1.5 rounded-pill d-flex align-items-center justify-content-center gap-1.5 advance-ticket-btn" data-ticket-number={ticket.ticket_number} data-next-status="en proceso" style="font-size: 0.72rem;">
																							Avanzar a En proceso <i class="ri-arrow-right-line"></i>
																						</button>
																						<button type="button" class="btn btn-xs btn-outline-danger w-100 py-1.5 rounded-pill d-flex align-items-center justify-content-center gap-1.5 reject-ticket-btn" data-ticket-number={ticket.ticket_number} style="font-size: 0.72rem;">
																							<i class="ri-close-circle-line"></i> Rechazar Solicitud
																						</button>
																					</div>
																				)}

																				{column.status === 'en proceso' && (
																					<div class="mt-2 d-flex flex-column gap-1">
																						<button type="button" class="btn btn-xs btn-dark w-100 py-1.5 rounded-pill d-flex align-items-center justify-content-center gap-1.5 advance-ticket-btn" data-ticket-number={ticket.ticket_number} data-next-status="finalizada" style="font-size: 0.72rem;">
																							<i class="ri-check-double-line"></i> Finalizar Ticket
																						</button>
																						<button type="button" class="btn btn-xs btn-outline-danger w-100 py-1.5 rounded-pill d-flex align-items-center justify-content-center gap-1.5 reject-ticket-btn" data-ticket-number={ticket.ticket_number} style="font-size: 0.72rem;">
																							<i class="ri-close-circle-line"></i> Rechazar Solicitud
																						</button>
																					</div>
