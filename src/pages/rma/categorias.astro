---
import AdminLayout from '../../components/AdminLayout.astro';
import { connectMongoose } from '../../lib/mongo';
import { readCookieValue, verifyAuthToken } from '../../lib/auth/jwt';
import { CategoryModel } from '../../lib/models/Category';

const authToken = readCookieValue(Astro.request.headers.get('cookie'), 'cx_auth');
const session = authToken ? verifyAuthToken(authToken) : null;
if (!session) return Astro.redirect('/login');
if (session.role !== 'admin') return Astro.redirect('/rma');

await connectMongoose();
const categories = await CategoryModel.find().sort({ createdAt: -1 }).lean();
---

<AdminLayout
	title="Categorías | CX Ergonomic"
	active="categorias"
	heading="Categorías de Productos"
	subheading="Administra las categorías del catálogo de productos y sus imágenes de portada."
	session={session}
>
	<button slot="actions" class="btn btn-dark rounded-pill px-3 fw-semibold" id="new-category-btn">
		<i class="ri-add-line me-1"></i> Nueva categoría
	</button>

	<div class="card shadow-sm">
		<div class="card-body p-0">
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th class="px-4 py-3" style="width: 80px;">Portada</th>
							<th class="py-3">Categoría</th>
							<th class="py-3">Slug</th>
							<th class="py-3">Descripción</th>
							<th class="py-3">Estado</th>
							<th class="px-4 py-3 text-end">Acciones</th>
						</tr>
					</thead>
					<tbody>
						{categories.length === 0 ? (
							<tr><td colspan="6" class="text-center text-muted py-5">No hay categorías registradas. Crea la primera.</td></tr>
						) : categories.map((cat) => (
							<tr data-id={cat._id.toString()} data-name={cat.name} data-description={cat.description || ''} data-image={cat.image || ''} data-active={String(cat.is_active)}>
								<td class="px-4 py-3">
									<div class="border rounded-2 overflow-hidden bg-light d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
										<img src={cat.image || '/img/logo-cx-ergonomic.webp'} alt={cat.name} class="w-100 h-100 object-fit-cover" onerror="this.src='/img/logo-cx-ergonomic.webp'" />
									</div>
								</td>
								<td class="py-3 fw-bold text-dark">{cat.name}</td>
								<td class="py-3"><code>{cat.slug}</code></td>
								<td class="py-3 text-muted small" style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
									{cat.description || '—'}
								</td>
								<td class="py-3">
									{cat.is_active
										? <span class="badge bg-success-subtle text-success">Activa</span>
										: <span class="badge bg-secondary-subtle text-secondary">Oculta</span>}
								</td>
								<td class="px-4 py-3 text-end">
									<button class="btn btn-sm btn-outline-secondary rounded-pill px-3 edit-category-btn">Editar</button>
									<button class="btn btn-sm btn-outline-danger rounded-pill px-3 delete-category-btn">Eliminar</button>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- Global Toast Container Local -->
	<div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 1100;">
		<div id="app-toast" class="toast align-items-center text-white border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 10px;">
			<div class="d-flex align-items-center">
				<div class="toast-body d-flex align-items-center gap-2">
					<i id="app-toast-icon" class="fs-5"></i>
					<span id="app-toast-message">Mensaje</span>
				</div>
				<button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
			</div>
		</div>
	</div>

	<!-- Modal crear/editar -->
	<div class="modal fade" id="categoryModal" tabindex="-1" aria-hidden="true">
		<div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
			<div class="modal-content border-0 shadow" style="border-radius: 12px;">
				<div class="modal-header bg-light">
					<h5 class="modal-title fw-bold" id="categoryModalTitle">Nueva categoría</h5>
					<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
				</div>
				<div class="modal-body p-4">
					<input type="hidden" id="category-id" />
					<div class="mb-3">
						<label class="form-label small fw-bold text-muted">Nombre <span class="text-danger">*</span></label>
						<input type="text" class="form-control" id="category-name" placeholder="Ej. Mesas Eléctricas" required />
					</div>
					<div class="mb-3">
						<label class="form-label small fw-bold text-muted">Descripción</label>
						<textarea class="form-control" id="category-description" rows="2" placeholder="Breve descripción de la línea de productos..."></textarea>
					</div>
					<div class="mb-3">
						<label class="form-label small fw-bold text-muted">Imagen de Portada</label>
						<div class="border border-2 border-dashed rounded-3 p-3 text-center" id="cat-drop" style="cursor:pointer;">
							<img id="cat-preview" src="" alt="" class="img-fluid rounded mb-2 d-none" style="max-height: 140px;" />
							<div id="cat-drop-text"><i class="ri-upload-cloud-2-line fs-3 d-block text-muted"></i><span class="small text-muted">Haz clic o arrastra una imagen aquí</span></div>
							<input type="file" id="cat-file" class="d-none" accept="image/*" />
						</div>
						<div class="progress mt-2 d-none" id="cat-progress" style="height:6px;"><div class="progress-bar bg-dark" id="cat-progress-bar" style="width:0%"></div></div>
						<input type="hidden" id="category-image" />
					</div>
					<div class="form-check">
						<input type="checkbox" class="form-check-input" id="category-active" checked />
						<label class="form-check-label small" for="category-active">Visible en la tienda</label>
					</div>
					<div class="alert alert-danger d-none mt-3 py-2 small" id="category-error"></div>
				</div>
				<div class="modal-footer border-top-0">
					<button type="button" class="btn btn-outline-secondary rounded-pill px-3" data-bs-dismiss="modal">Cancelar</button>
					<button type="button" class="btn btn-dark rounded-pill px-3" id="save-category-btn">Guardar</button>
				</div>
			</div>
		</div>
	</div>

	<script is:inline>
		(function () {
			const bs = () => window.bootstrap;
			const modalEl = document.getElementById('categoryModal');
			const elId = document.getElementById('category-id');
			const elName = document.getElementById('category-name');
			const elDesc = document.getElementById('category-description');
			const elImg = document.getElementById('category-image');
			const elActive = document.getElementById('category-active');
			const elError = document.getElementById('category-error');
			const elTitle = document.getElementById('categoryModalTitle');

			const drop = document.getElementById('cat-drop');
			const fileInput = document.getElementById('cat-file');
			const preview = document.getElementById('cat-preview');
			const dropText = document.getElementById('cat-drop-text');
			const progress = document.getElementById('cat-progress');
			const progressBar = document.getElementById('cat-progress-bar');

			function uploadFile(file) {
				return new Promise((resolve, reject) => {
					const fd = new FormData();
					fd.append('file', file);
					const xhr = new XMLHttpRequest();
					xhr.open('POST', '/api/catalog/categories/upload');
					xhr.upload.addEventListener('progress', (e) => {
						if (e.lengthComputable) progressBar.style.width = `${Math.round((e.loaded * 100) / e.total)}%`;
					});
					xhr.addEventListener('load', () => {
						if (xhr.status === 201) {
							const r = JSON.parse(xhr.responseText);
							resolve(r.url || r.path);
						} else {
							try { reject(new Error(JSON.parse(xhr.responseText).error)); } catch { reject(new Error('Error al subir la imagen')); }
						}
					});
					xhr.addEventListener('error', () => reject(new Error('Error de red')));
					xhr.send(fd);
				});
			}

			drop.addEventListener('click', () => fileInput.click());
			fileInput.addEventListener('change', async () => {
				const file = fileInput.files && fileInput.files[0];
				if (!file) return;
				elError.classList.add('d-none');
				progress.classList.remove('d-none');
				try {
					const imageUrl = await uploadFile(file);
					elImg.value = imageUrl;
					preview.src = imageUrl;
					preview.classList.remove('d-none');
					dropText.classList.add('d-none');
				} catch (err) { elError.textContent = err.message; elError.classList.remove('d-none'); }
				finally { progress.classList.add('d-none'); progressBar.style.width = '0%'; }
			});

			function showToast(message, type = 'danger') {
				const toastEl = document.getElementById('app-toast');
				const iconEl = document.getElementById('app-toast-icon');
				const msgEl = document.getElementById('app-toast-message');
				if (!toastEl || !iconEl || !msgEl) return;

				toastEl.className = 'toast align-items-center text-white border-0 shadow-lg';
				iconEl.className = 'fs-5';

				if (type === 'success') {
					toastEl.classList.add('bg-success');
					iconEl.className = 'ri-checkbox-circle-fill fs-5';
				} else {
					toastEl.classList.add('bg-danger');
					iconEl.className = 'ri-close-circle-fill fs-5';
				}

				msgEl.textContent = message;
				bs().Toast.getOrCreateInstance(toastEl).show();
			}

			function openModal(data) {
				elError.classList.add('d-none');
				elId.value = data ? data.id : '';
				elName.value = data ? data.name : '';
				elDesc.value = data ? data.description : '';
				elImg.value = data ? data.image : '';
				if (elImg.value) {
					preview.src = elImg.value;
					preview.classList.remove('d-none');
					dropText.classList.add('d-none');
				} else {
					preview.classList.add('d-none');
					dropText.classList.remove('d-none');
				}
				elActive.checked = data ? data.active : true;
				elTitle.textContent = data ? 'Editar categoría' : 'Nueva categoría';
				bs().Modal.getOrCreateInstance(modalEl).show();
			}

			document.getElementById('new-category-btn').addEventListener('click', () => openModal());

			document.querySelectorAll('.edit-category-btn').forEach((btn) => {
				btn.addEventListener('click', () => {
					const row = btn.closest('tr');
					openModal({
						id: row.getAttribute('data-id'),
						name: row.getAttribute('data-name'),
						description: row.getAttribute('data-description'),
						image: row.getAttribute('data-image'),
						active: row.getAttribute('data-active') === 'true',
					});
				});
			});

			document.getElementById('save-category-btn').addEventListener('click', async () => {
				elError.classList.add('d-none');
				const id = elId.value;
				const payload = {
					id,
					name: elName.value.trim(),
					description: elDesc.value.trim(),
					image: elImg.value.trim(),
					is_active: elActive.checked
				};
				if (!payload.name) { elError.textContent = 'El nombre es obligatorio.'; elError.classList.remove('d-none'); return; }
				
				try {
					const res = await fetch(id ? '/api/catalog/categories/update' : '/api/catalog/categories/create', {
						method: 'POST',
						headers: { 'content-type': 'application/json' },
						body: JSON.stringify(payload),
					});
					const data = await res.json();
					if (!res.ok) throw new Error(data.error || 'Error al guardar');
					window.location.reload();
				} catch (err) {
					elError.textContent = err.message;
					elError.classList.remove('d-none');
				}
			});

			document.querySelectorAll('.delete-category-btn').forEach((btn) => {
				btn.addEventListener('click', async () => {
					const row = btn.closest('tr');
					const catId = row.getAttribute('data-id');
					const catName = row.getAttribute('data-name');
					if (!confirm(`¿Eliminar la categoría "${catName}"? Se validará que no tenga productos asociados.`)) return;

					try {
						const res = await fetch('/api/catalog/categories/delete', {
							method: 'POST',
							headers: { 'content-type': 'application/json' },
							body: JSON.stringify({ id: catId }),
						});
						const data = await res.json();
						if (!res.ok) throw new Error(data.error || 'Error al eliminar');
						window.location.reload();
					} catch (err) {
						showToast(err.message, 'danger');
					}
				});
			});
		})();
	</script>
</AdminLayout>
